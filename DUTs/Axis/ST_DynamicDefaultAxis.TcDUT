  <DUT Name="ST_DynamicDefaultAxis" Id="{72be789d-603f-431c-aff2-c92b111b8584}">
    <Declaration><![CDATA[TYPE ST_DynamicDefaultAxis :
STRUCT
	///um/s
	fDefaultVelocity: LREAL := 100000;
	/// um/s*s
	fDefaultAccelaration: LREAL := 5000000;
	/// um/s*s
	fDefaultDeceleration: LREAL := 5000000;
	fDefaultJerk: LREAL := 50000000;
	///um/s
	fMaxVelocity: LREAL := 5000000;
	/// um/s*s
	fMaxAccelaration: LREAL := 20000000;
	/// um/s*s
	fMaxDeceleration: LREAL := 20000000;
	fMaxJerk: LREAL := 200000000;
END_STRUCT
END_TYPE
]]></Declaration>
