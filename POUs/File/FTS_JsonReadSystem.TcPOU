<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FTS_JsonReadSystem" Id="{1661dc0b-cb0d-4d52-a826-93202d22a38d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FTS_JsonReadSystem
VAR_INPUT
	bExecute: BOOL;
	sJsonPath: STRING;
	nMoverNum: UINT;
END_VAR
VAR_OUTPUT
	bBusy: BOOL;
	bDone: BOOL;
	bError: BOOL;
	nErrorId: UDINT;
	hrErrorCode: HRESULT;
END_VAR
VAR_IN_OUT
	///aMovers      :ARRAY [1..GVL.MAX_MOVER] OF ST_Mover;
	aAxis: ARRAY[1..GVL_MC.MAX_MOVER] OF ST_Axis;
END_VAR
VAR
	_bLoaded: BOOL;
	_bLoad: BOOL;
	_bHasMember: BOOL;
	_nStep: INT;
	_nArraySize: UINT;
	_nSysType: UINT;
	_nIndex: UINT;
	_sJsonRoot: SJsonValue;
	_sJsonProp: SJsonValue;
	_sJsonSubRoot: SJsonValue;
	_pJsonValue: Tc3_JsonXml.PVOID;
	_fbTrig: R_TRIG;
	_fbJson: FB_JsonDomParser;
	_fbDoneTon: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_fbTrig(CLK:=bExecute , Q=> );

IF _fbTrig.Q AND(_nStep=0)THEN
	_nStep:=10;
	
END_IF
IF (nMoverNum=0)THEN 
	nMoverNum:=10;
END_IF


CASE _nStep  OF 
	0:
	    IF NOT bExecute THEN 
			bError:=FALSE;
			nErrorId:=0;
		END_IF
	    RETURN ;
 

    10:
	     bBusy:=TRUE;
		 bDone:=FALSE;   
	     bError:=FALSE;
		 nErrorId:=0;
		 _bLoad:=TRUE;
		 _nStep:=_nStep+10;
		 
		 
    20:
	     IF _bLoad  THEN
			 _bLoaded :=_fbJson.LoadDocumentFromFile(sFile:=sJsonPath , bExec:=_bLoad , hrErrorCode=>hrErrorCode );
		 ELSE
			 
			 IF _bLoaded THEN
			        _nStep:=_nStep+10;
					_bLoaded:=FALSE;
				 ELSE
					_nStep:=100;
                    nErrorId:=32576;
			     END_IF 
		 END_IF 
		 
    30:
	        _sJsonRoot:=_fbJson.GetDocumentRoot();
		    _sjsonProp := _fbJson.FindMemberPath(_sJsonRoot, 'system');
			_bHasMember := _fbJson.HasMember(_sjsonProp,'fts_type');
			IF (_bHasMember) THEN
               _bHasMember := FALSE;
               _sJsonSubRoot := _fbJson.FindMember(_sjsonProp, 'fts_type');
               _nSysType := STRING_TO_UINT(_fbJson.GetString(_sJsonSubRoot));
            END_IF
			
			FOR  _nIndex:=1 TO GVL_MC.MAX_MOVER  DO
			//FOR  _nIndex:=1 TO nMoverNum   DO
 
				aAxis[_nIndex].stAxisParam.stRoadParam.nSysType:=_nSysType;
			    aAxis[_nIndex].stNcTOPLC.nAxisId:=aAxis[_nIndex].stAxisParam.nAxisId;
			END_FOR
            
		  _nStep:=_nStep+10;
	    
   40:
        bBusy:=FALSE;
	    bDone:=TRUE; 
		_fbDoneTon(IN:=FALSE , PT:= T#100MS, Q=> , ET=> );
	   _nStep:=_nStep+10;
   
   50:
        _fbDoneTon(IN:=TRUE , PT:= T#100MS, Q=> , ET=> );
		IF _fbDoneTon.Q  THEN 
	        bDone:=FALSE;   
            _nStep:=0;
			_fbDoneTon(IN:=FALSE , PT:= T#100MS, Q=> , ET=> );
        END_IF 

   100:  // error handle 
         bBusy:=FALSE;
		 bDone:=FALSE;   
	     bError:=TRUE;
		 //nErrorId:=DINT_TO_UDINT(hrErrorCode);
         _nStep:=0;

END_CASE]]></ST>
    </Implementation>
    <LineIds Name="FTS_JsonReadSystem">
      <LineId Id="3" Count="82" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>