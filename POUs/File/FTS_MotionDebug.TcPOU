<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FTS_MotionDebug" Id="{7d5c08fd-9d25-4d0a-9fbe-67a27e546ccc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FTS_MotionDebug
VAR_INPUT
	nDebugMode: WORD;
	nMaxDecRatio  :UINT;
	nFollowError  :UDINT;
	nMecReserveDis   :UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 轴日志打印
GVL_MC.cDebug:=nDebugMode.0;
GVL_MC.bDebugDecAcc:=nDebugMode.1;
GVL_MC.bEmStop:=nDebugMode.2;
GVL_MC.bEmStopVMode:=nDebugMode.3;
// 07.13
IF nMaxDecRatio<>0 THEN 
	GVL_MC.nMaxDecRatio:=ABS(nMaxDecRatio);
END_IF
IF nFollowError<>0 THEN 
	GVL_MC.nFollowError:=ABS(nFollowError);
END_IF

IF nMecReserveDis<>0 THEN 
	GVL_MC.nMecReserveDis:=ABS(nMecReserveDis);
END_IF
]]></ST>
    </Implementation>
    <LineIds Name="FTS_MotionDebug">
      <LineId Id="3" Count="2" />
      <LineId Id="11" Count="0" />
      <LineId Id="22" Count="0" />
      <LineId Id="19" Count="0" />
