<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FTS_MCMoveAdditive_Std" Id="{79e060bb-c76c-4de5-888c-886477ea7dc6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FTS_MCMoveAdditive_Std
VAR_IN_OUT
	stAxis: ST_Axis;
END_VAR
VAR_INPUT
	bExecute: BOOL;
	fDistance: LREAL;
	fVelocity: LREAL;
	fAcceleration: LREAL;
	fDeceleration: LREAL;
	fJerk: LREAL;
END_VAR
VAR_OUTPUT
	bDone: BOOL;
	bActive: BOOL;
	bBusy: BOOL;
	bCommandAborted: BOOL;
	bError: BOOL;
	nErrorID: UDINT;
END_VAR
VAR
	_bNcStart: BOOL;
	_bSegDone: BOOL;
	_bPathCalDone: BOOL := FALSE;
	_bParamError: BOOL := FALSE;
	_nStep: INT;
	_nCycleCount: UDINT := 0;
	///02.24
	_nLastNcCycleCounter: UDINT;
	///02.24
	_nDealtNcCycleCounter: UDINT;
	///02.24
	_nLastCycleCounter: UDINT;
	///02.24
	_nDealtCycleCounter: UDINT;
	_fPostion: LREAL;
	_fDec: LREAL;
	_fAcc: LREAL;
	_fDistance: LREAL;
	_fGap: LREAL;
	_fClampLength: LREAL;
	_fSetVelo: LREAL;
	_fSetPos: LREAL;
	_fPrePosition: LREAL;
	_fSSshaped_Postion: LREAL;
	_fA_max: LREAL;
	_fA_Lim: LREAL;
	_fJ_max: LREAL;
	_fVmin_Cal: LREAL;
	_fV_max: LREAL;
	_fTj: LREAL;
	_fTd: LREAL;
	_eCommand: E_Command := E_Command.COMMAND_IDLE;
	_eDirection: E_Direction;
	_pPremover: POINTER TO ST_Axis;
	_stTimeInfo: ST_TimeRef;
	_stPathRef: ST_PathRef;
	_stNoPathRef: ST_PathRef;
	_stAxisNo: ST_Axis;
	_fbTrig: R_TRIG;
	///03.04
	_fbEnbleTrig: F_TRIG;
	_fbDoneTon: TON;
	_fbWaitTon: TON;
	_fbTraPlanning: FB_TrajectoryPlanning;
END_VAR
VAR CONSTANT
	//fNcCycle: REAL := 0.001;
	tcDoneTime: TIME := TIME#100ms;
	tcWaitTime: TIME := TIME#500ms;
	tcCalcuTime: TIME := TIME#33m20s0ms;
	fPositivePosSet: LREAL := 500000000;
	fNegativePosSet: LREAL := -500000000;
	fGapSet: LREAL := 100000;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//A_MeasureIn();

IF (fDistance>=0)THEN 
	_eDirection:=E_Direction.DIRECTION_POSITIVE;
ELSE
	_eDirection:=E_Direction.DIRECTION_NEGATIVE;
END_IF

A_CommandCheck();
// 02.24增加task事件判断
IF (_nStep<>0)THEN 
	_nCycleCount:=_nCycleCount+1;
ELSE
	_nCycleCount:=0;
END_IF

CASE _nStep OF 
	0:
	    
	   IF NOT bExecute THEN 
		   bError:=FALSE;
		   nErrorId:=0;
		   bDone:=FALSE;
		   bCommandAborted:=FALSE;
		    _eCommand:=E_Command.COMMAND_IDLE;
	   END_IF   
	   RETURN;
	   	
	10:
	     bBusy:=TRUE;
	     bError:=FALSE;
	     bCommandAborted:=FALSE;
	     nErrorID:=0;
	     bActive:=FALSE;
		 bDone:=FALSE;
		 IF (stAxis.stPLCTONC.eCommand<>E_Command.COMMAND_ADDITIVE)THEN
			 IF NOT stAxis.stPLCTONC.bNcStart THEN
				 _nStep:= 20;
			 END_IF
		 ELSE
			 stAxis.stPLCTONC.bNcStart:=FALSE;
		     _nStep:= 20;
		 END_IF
        //_nStep:=10+_nStep;
		//stAxis.stPLCTONC.bNcStart:=FALSE;
		A_ParamCheck();
		IF _bParamError  THEN 
			 _nStep:= 100;
			 _bParamError:=FALSE;
		 END_IF
	
		
	20:  //calculate path 
	    bActive:=TRUE;
	    A_CalcutaPath();
		stAxis.stAxisStatus.bDiscreteMotion:=TRUE;
		stAxis.stAxisStatus.bContinuousMotion:=FALSE;
		stAxis.stAxisStatus.bSynchronizedMotion:=FALSE;
		stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_ADDITIVE;
	    _eCommand:=E_Command.COMMAND_ADDITIVE;
		 
		IF _bPathCalDone THEN
			stAxis.stPLCTONC.bNcEnable:=TRUE;
		    stAxis.stPLCTONC.bNcStart:=TRUE;
		    //stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_ADDITIVE;
			//_eCommand:=E_Command.COMMAND_ADDITIVE;
			IF (fJerk=0) THEN
				stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_TSHAPED;
			ELSE
				stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_SSHAPED;
		    END_IF
		  
	        stAxis.stAxisStatus.bMoving:=TRUE;
			
			_nStep:=_nStep+5;
			_bPathCalDone:=FALSE;
		END_IF
		IF _bSegDone THEN 
			_nStep:=0;
			bBusy:=FALSE;
			bActive:=FALSE;
			bDone:=TRUE;
			_bSegDone:=FALSE;
	        stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
			_eCommand:=E_Command.COMMAND_IDLE;
			stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
			RETURN;
		END_IF
   25:
        _nStep:=30;
		//stAxis.stPLCTONC.bNcStart:=FALSE;
		 //自动计算nc task和规划task 02.24
		 _nDealtCycleCounter:=_nCycleCount-_nLastCycleCounter;
		 _nDealtNcCycleCounter:=stAxis.stAxisStatus.nNcCycleCounter_WP-_nLastNcCycleCounter;
		 IF (_nDealtCycleCounter< _nDealtNcCycleCounter)THEN
			  stAxis.stPLCTONC.bNcStart:=FALSE;     //12.27
		 END_IF
   30:
        stAxis.stPLCTONC.bNcStart:=FALSE;
		IF (stAxis.stNcTOPLC.nAxisState=2)THEN
			bBusy:=FALSE;
	        bError:=FALSE;
	        bCommandAborted:=FALSE;
		    bActive:=FALSE;
	        nErrorID:=0;
		    bDone:=TRUE;
            _fbDoneTon(IN:=FALSE, PT:=tcDoneTime , Q=> , ET=> );
			IF bExecute THEN 
				_nStep:=0;
		       
		        stAxis.stAxisStatus.bMoving:=FALSE;
				stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		        stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
				_eCommand:=E_Command.COMMAND_IDLE;
		       stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
			   stAxis.stPLCTONC.bNcStart:=FALSE;
		       stAxis.stPLCTONC.bNcEnable:=FALSE;
			ELSE
				_nStep:=35; 
			END_IF
	       
	    END_IF
		
    35:
	    // _fbDoneTon(IN:=TRUE, PT:=tcDoneTime , Q=> , ET=> );
        // IF _fbDoneTon.Q THEN
		     bDone:=FALSE;
		    _fbDoneTon(IN:=FALSE, PT:=tcDoneTime , Q=> , ET=> );
		    _nStep:=0;
		 
		    //stAxis.stAxisStatus.eMotionState:=E_MCAxisStates.MC_AXISSTATE_STANDSTILL;
		    stAxis.stAxisStatus.bMoving:=FALSE;
			//stAxis.stAxisStatus.bStandStill:=TRUE;
			stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		    stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
			_eCommand:=E_Command.COMMAND_IDLE;
		    stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
			stAxis.stPLCTONC.bNcStart:=FALSE;
		    stAxis.stPLCTONC.bNcEnable:=FALSE;
	  // END_IF	
	
    //  disEnable     
    40:
	    IF (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN
			A_StopPathGeneration();
			 stAxis.stPLCTONC.bNcStart:=TRUE;
			_nStep:=_nStep+10;
	    ELSE
		   
            _nStep:=60;
		END_IF 
	   
    50:
	    IF (stAxis.stNcTOPLC.nAxisState=2)THEN
	       _nStep:=_nStep+10; 
		   stAxis.stPLCTONC.bNcStart:=FALSE;
           
        END_IF
	60:
    	
	    //_fbDoneTon(IN:=TRUE, PT:=tcDoneTime , Q=> , ET=> );
       // IF _fbDoneTon.Q THEN
			 bCommandAborted:=TRUE;
			 bBusy:=FALSE;
	         bActive:=FALSE;
			 bDone:=FALSE;
			 _fbDoneTon(IN:=FALSE, PT:=tcDoneTime , Q=> , ET=> );
			  _nStep:=0;
			  stAxis.stAxisStatus.bMoving:=FALSE;
			 stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
			  stAxis.stPLCTONC.bNcEnable:=FALSE;
			  stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
			  stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
			  _eCommand:=E_Command.COMMAND_IDLE;
			 
	    // END_IF	 
		
    100: (************error handle***********)
         bBusy:=FALSE;
	     bError:=TRUE;
	     bDone:=FALSE;
		 bActive:=FALSE;
	     bCommandAborted:=FALSE;
	     stAxis.stAxisStatus.bError:=TRUE;
		 stAxis.stAxisStatus.nErrorId:=nErrorId;
	     //stAxis.stAxisStatus.bStandStill:=FALSE;
		 stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		 stAxis.stAxisStatus.bMoving:=FALSE;
	     _nStep:=0;
		 stAxis.stPLCTONC.bNcStart:=FALSE;
		 stAxis.stPLCTONC.bNcEnable:=FALSE;
		 stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
	     stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
		 _eCommand:=E_Command.COMMAND_IDLE;
		 
    110:(************command aborted***********)  //03.04
	     bCommandAborted:=TRUE;
	     bBusy:=FALSE;
		 bDone:=FALSE;
		 bActive:=FALSE;
		 _nStep:=0; 
		 stAxis.stAxisStatus.bMoving:=FALSE;
		
END_CASE


A_UpstateStatus();

]]></ST>
    </Implementation>
    <Action Name="A_CalcutaPath" Id="{a6731508-d299-46c4-9ecd-e51d8d5dd10a}">
      <Implementation>
        <ST><![CDATA[
stAxis.stPLCTONC.stStartPosition.fPosition:=stAxis.stNcTOPLC.fActPos;
stAxis.stPLCTONC.stStartPosition.fVelocity:=stAxis.stNcTOPLC.fActVelo;
stAxis.stPLCTONC.stStartPosition.fAccleration:=_fAcc;
stAxis.stPLCTONC.stStartPosition.fDeceleration:=_fDec;
stAxis.stPLCTONC.stStartPosition.fbJerk:=fJerk;

stAxis.stPLCTONC.fTargetVelocity:=_fSetVelo;
stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
stAxis.stPLCTONC.stEndPosition.fAccleration:=_fAcc;
stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;
stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk;
stAxis.stPLCTONC.stEndPosition.fPosition:=fDistance+stAxis.stPLCTONC.stStartPosition.fPosition;

_fDistance:=ABS(stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition);
	
IF (_fDistance<=10)THEN 
   _bSegDone:=TRUE;
	 RETURN ;
 END_IF
 
IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	stAxis.stAxisStatus.bPositiveDirection:=TRUE;
	stAxis.stAxisStatus.bNegativeDirection:=FALSE;
ELSE
    stAxis.stAxisStatus.bPositiveDirection:=FALSE;
	stAxis.stAxisStatus.bNegativeDirection:=TRUE;
END_IF 


 _bPathCalDone:=true;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_CommandCheck" Id="{af303dee-eb9d-412f-ace7-8a81b6ca1fc4}">
      <Implementation>
        <ST><![CDATA[
//注意优先级，最下面优先级最高

_fbTrig(CLK:=bExecute , Q=> );
IF _fbTrig.Q  THEN
	
	IF (NOT stAxis.stAxisStatus.bEnabled) OR stAxis.stAxisStatus.bError OR stAxis.stAxisStatus.bStopping THEN 
		_nStep:=100;
		//bError:=TRUE;
		nErrorID:=30093;
		RETURN;
	END_IF
	_nStep:=10;
	
END_IF

//command aborted  

IF (stAxis.stPLCTONC.eCommand<>E_Command.COMMAND_ADDITIVE) AND (_nStep<>0)AND(_eCommand=E_Command.COMMAND_ADDITIVE)THEN 
	_nStep:=110;
END_IF

	
// disEnable
_fbEnbleTrig(CLK:=stAxis.stAxisStatus.bEnabled, Q=> );
IF _fbEnbleTrig.Q THEN 
	//bCommandAborted:=TRUE;
	IF (_nStep=0)THEN
		bBusy:=FALSE;
	    bDone:=FALSE;
	    bActive:=FALSE;
	    _nStep:=0; 
	
	ELSE
		//_nStep:=40;   //规划
		_nStep:=60;     // 不规划
	END_IF
	 
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Init" Id="{0d18bef9-65d5-4b44-a2ec-ad0e43afd3df}">
      <Implementation>
        <ST><![CDATA[_bPathCalDone:=FALSE;
_stPathRef:=_stNoPathRef;
bCommandAborted:=FALSE;
 _bSegDone:=false;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MeasureIn" Id="{8d6cb304-6d11-45bd-bc70-18770e21f4f7}">
      <Implementation>
        <ST><![CDATA[
_fClampLength:=stAxis.stAxisParam.fClampLength*0.5;

IF ABS(fVelocity)>stAxis.stAxisParam.stDynamicDefault.fMaxVelocity THEN 
	_fSetVelo:= stAxis.stAxisParam.stDynamicDefault.fMaxVelocity ;
ELSE
	_fSetVelo:= ABS(fVelocity) ;
END_IF

IF (fAcceleration=0) THEN 
	_fAcc:=stAxis.stAxisParam.stDynamicDefault.fDefaultAccelaration;
ELSE
	_fAcc:=ABS(fAcceleration);
	IF (fAcceleration>stAxis.stAxisParam.stDynamicDefault.fMaxAccelaration)THEN
		_fAcc:=stAxis.stAxisParam.stDynamicDefault.fMaxAccelaration;
	END_IF
END_IF


IF (fDeceleration=0) THEN
   _fDec:=stAxis.stAxisParam.stDynamicDefault.fDefaultDeceleration;
ELSE 
	_fDec:=ABS(fDeceleration);
	IF (fDeceleration>stAxis.stAxisParam.stDynamicDefault.fMaxDeceleration)THEN
		_fDec:=stAxis.stAxisParam.stDynamicDefault.fMaxDeceleration;
	END_IF
END_IF

IF (_fAcc<>_fDec)THEN
	_fDec:=_fAcc;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_ParamCheck" Id="{392399bc-d259-445c-8767-cace6da2cb5c}">
      <Implementation>
        <ST><![CDATA[A_MeasureIn();

IF (fDistance<>0) AND (fVelocity=0) THEN       // param error 
			
	_bParamError:=TRUE;		
	nErrorID:=30098;
	RETURN;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_StopPathGeneration" Id="{c0edd898-f3d7-4708-bc9d-418907428715}">
      <Implementation>
        <ST><![CDATA[
(*_fPostion:=0.5*stAxis.stNcTOPLC.fActVelo*stAxis.stNcTOPLC.fActVelo/_fDec;
//_fPostion:=0.5*stAxis.stNcTOPLC.fActVelo*stAxis.stNcTOPLC.fActVelo/stAxis.stAxisParam.stDynamicDefault.fMaxDeceleration;
IF stAxis.stAxisStatus.bPositiveDirection THEN
	 stAxis.stPLCTONC.stEndPosition.fPosition:=_fPostion+stAxis.stNcTOPLC.fActPos;
ELSE
	stAxis.stPLCTONC.stEndPosition.fPosition:=stAxis.stNcTOPLC.fActPos-_fPostion;
END_IF

stAxis.stPLCTONC.fTargetVelocity:=stAxis.stNcTOPLC.fActVelo;
stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
stAxis.stPLCTONC.stEndPosition.fAccleration:=_fDec;
stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;*)

_fPostion:=0.5*stAxis.stNcTOPLC.fActVelo*stAxis.stNcTOPLC.fActVelo/_fDec;
IF (fJerk=0)THEN
		IF stAxis.stAxisStatus.bPositiveDirection THEN
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fPostion+stAxis.stNcTOPLC.fActPos;
		ELSE
			stAxis.stPLCTONC.stEndPosition.fPosition:=stAxis.stNcTOPLC.fActPos-_fPostion;
		END_IF
		
		stAxis.stPLCTONC.fTargetVelocity:=stAxis.stNcTOPLC.fActVelo;
		stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
		stAxis.stPLCTONC.stEndPosition.fAccleration:=fDeceleration;
		stAxis.stPLCTONC.stEndPosition.fDeceleration:=fDeceleration;
ELSE
	    _fA_max:=fDeceleration;
		_fJ_max:=fJerk;
	    _fVmin_Cal:=_fA_max*_fA_max/_fJ_max;
		_fV_max:=stAxis.stNcTOPLC.fActVelo;
		IF (_fV_max>=_fVmin_Cal) THEN     //加速度可达
           _fTj:=_fA_max/_fJ_max;
           _fTd:=_fV_max/_fA_max +_fTj;
        ELSE
			_fA_Lim:=SQRT(_fV_max*_fJ_max);
			_fTj:=_fA_Lim/_fJ_max;
			_fTd:=2*_fTj;
        END_IF
		_fSSshaped_Postion:=0.5*_fTd*_fV_max;
	    stAxis.stPLCTONC.stStartPosition.fPosition:=stAxis.stNcTOPLC.fActPos;
		stAxis.stPLCTONC.stStartPosition.fVelocity:=stAxis.stNcTOPLC.fActVelo;
		stAxis.stPLCTONC.stStartPosition.fAccleration:=fDeceleration;
		stAxis.stPLCTONC.stStartPosition.fDeceleration:=fDeceleration;
		stAxis.stPLCTONC.stStartPosition.fbJerk:=fJerk ;
		IF stAxis.stAxisStatus.bPositiveDirection THEN
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fSSshaped_Postion+stAxis.stNcTOPLC.fActPos;
		ELSE
			stAxis.stPLCTONC.stEndPosition.fPosition:=stAxis.stNcTOPLC.fActPos-_fSSshaped_Postion;
		END_IF
		
		stAxis.stPLCTONC.fTargetVelocity:=stAxis.stNcTOPLC.fActVelo;
		stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
		stAxis.stPLCTONC.stEndPosition.fAccleration:=fDeceleration;
		stAxis.stPLCTONC.stEndPosition.fDeceleration:=fDeceleration;
		stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk ;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_UpstateStatus" Id="{6adb3bcf-f26a-497d-85fc-dcbae5cc2600}">
      <Implementation>
        <ST><![CDATA[//02.24
_nLastCycleCounter:=_nCycleCount;
_nLastNcCycleCounter:=stAxis.stAxisStatus.nNcCycleCounter_WP;
]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="FTS_MCMoveAdditive_Std">
      <LineId Id="3" Count="207" />
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FTS_MCMoveAdditive_Std.A_CalcutaPath">
      <LineId Id="2" Count="29" />
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FTS_MCMoveAdditive_Std.A_CommandCheck">
      <LineId Id="2" Count="37" />
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FTS_MCMoveAdditive_Std.A_Init">
      <LineId Id="2" Count="2" />
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FTS_MCMoveAdditive_Std.A_MeasureIn">
      <LineId Id="2" Count="29" />
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FTS_MCMoveAdditive_Std.A_ParamCheck">
      <LineId Id="2" Count="6" />
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FTS_MCMoveAdditive_Std.A_StopPathGeneration">
      <LineId Id="2" Count="55" />
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FTS_MCMoveAdditive_Std.A_UpstateStatus">
      <LineId Id="2" Count="2" />
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>