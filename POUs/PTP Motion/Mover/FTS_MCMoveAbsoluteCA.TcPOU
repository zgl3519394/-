<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FTS_MCMoveAbsoluteCA" Id="{5d6a5a44-b530-4f79-805d-3bea2756db35}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FTS_MCMoveAbsoluteCA
VAR_IN_OUT
	stAxis: ST_Axis;
END_VAR
VAR_INPUT
	bExecute: BOOL;
	bContinuousUpdate: BOOL;
	bCollsionNotValid: BOOL := FALSE;
	fPosition: LREAL;
	fVelocity: LREAL;
	fAcceleration: LREAL;
	fDeceleration: LREAL;
	fJerk: LREAL;
	fGap: LREAL;
	eDirection: E_Direction := 1;
	eBufferMode: E_MCBufferMode := E_MCBufferMode.ABORTING;
	stNextRoadParam: ST_ForKRoadParam;
END_VAR
VAR_OUTPUT
	bDone: BOOL;
	bBusy: BOOL;
	bActive: BOOL;
	bCommandAborted: BOOL;
	bError: BOOL;
	nErrorId: UDINT;
END_VAR
VAR
	_bCollisionChecked: BOOL;
	_bCounterTriger: BOOL := FALSE;
	_bPathSafe: BOOL := FALSE;
	_bSameCycle: BOOL := FALSE;
	_bPathCalDone: BOOL := FALSE;
	/// _bSameVelo         :BOOL:=FALSE;
	/// _bAutoFillIn       :BOOL:=FALSE;
	_bPathCalExecute: BOOL := FALSE;
	_bParamError: BOOL := FALSE;
	_bSegDone: BOOL;
	_bNcStart: BOOL;
	_bTargetDiff: BOOL;
	_bSegOver: BOOL := FALSE;
	_bPreGeneSegDone: BOOL := FALSE;
	_bNegPosStop: BOOL := FALSE;
	///_bStartTime    :BOOL;
	_bDyPathUpdate: BOOL := FALSE;
	_bDyPathCalOk: BOOL := FALSE;
	///03.31
	_bIsGroupMember: BOOL := FALSE;
	_eCommand: E_Command;
	/// _nCollState        :WORD;
	_nStep: INT;
	_nSysType: UINT;
	_nNextRoadID: UINT;
	_nPointNum: UDINT;
	_nPrePointNum: UDINT;
	_nCycleCount: UDINT := 0;
	_nSyncCounter: UDINT := 0;
	///02.24
	_nLastNcCycleCounter: UDINT;
	///02.24
	_nDealtNcCycleCounter: UDINT;
	///02.24
	_nLastCycleCounter: UDINT;
	///02.24
	_nDealtCycleCounter: UDINT;
	/// _nErrorId        : UDINT;
	_fPrePosition: LREAL;
	_fPrePositionTemp: LREAL;
	_fPrePositionTemp1: LREAL;
	_fPostion: LREAL;
	_fTotalTime: LREAL;
	_fPreCurTime: LREAL;
	_fCurrentTime: LREAL;
	_fStartTime: LREAL;
	_fStartVelocity: LREAL;
	_fStartPosition: LREAL;
	_fLastVelocity: LREAL;
	///_nCounter    :INT;
	///_fPostion    :LREAL;
	_fDistance: LREAL;
	_fStartPos: LREAL;
	_fDelat_Pos: LREAL;
	_fDelat_StartPos: LREAL;
	_fSetVelo: LREAL;
	_fSetPos: LREAL;
	_fExpVelo: LREAL;
	_fPosMin: LREAL;
	_fClampLength: LREAL;
	_fGap: LREAL;
	/// 成组组内gap 03.31
	_fGroupInGap: LREAL;
	_fSafePos: LREAL;
	_fDyPathDis1: LREAL;
	_fDyPathDis2: LREAL;
	_fAcc: LREAL;
	_fDec: LREAL;
	_fRealDis: LREAL;
	_fGapSet: LREAL;
	_fLastParam_Pos: LREAL;
	_fLastParam_Vel: LREAL;
	_fLastGap: LREAL;
	_fCuRoadLength: LREAL;
	_fNextRoadLength: LREAL;
	_fNextNewPrePosition: LREAL;
	_fNewPrePosition: LREAL;
	_sMessage: STRING;
	_eGroupType: E_GroupType;
	_eTrackType: E_TrackType;
	_eNextRoadDirection: E_Direction;
	_pPremover: POINTER TO ST_Axis;
	_pNextRoadmover: POINTER TO ST_Axis;
	_stAxisNo: ST_Axis;
	_stPrePathRef: ST_PathRef;
	_stPathPointTemp: ST_Point;
	_stPathNoPoint: ST_Point;
	_stPathRef: ST_PathRef;
	_stNoPathRef: ST_PathRef;
	_stLastCmdExeParam: ST_MCExecuteParam;
	_aNoPath: ARRAY[0..2] OF ST_PathSegment;
	_fbTrig: R_TRIG;
	_fbReTrig: R_TRIG;
	_fbPosTrig: R_TRIG;
	///03.04
	_fbEnbleTrig: F_TRIG;
	///03.04
	_fbPreMoveErrTrig: R_TRIG;
	_fbDyTrig: R_TRIG;
	_fbSynMotion: R_TRIG;
	_fbTon: TON;
	_fbDoneTon: TON;
	_fbWaitTon: TON;
	///03.04
	_fCommandAbortedTon: ton;
	///03.04
	_fErrorTon: ton;
	_fbTraPlanning: FB_TrajectoryPlanning;
	_fNeRoadMoverPos: LREAL;
END_VAR
VAR CONSTANT
	//fNcCycle: REAL := 0.001;
	fPosMin: REAL := 1000;
	///按最大速度计算
	fDealtGap: REAL := 50000;
	fPreSetDis: REAL := 100000;
	tcDoneTime: TIME := TIME#100ms;
	tcWaitTime: TIME := TIME#50ms;
	tcCalcuTime: TIME := TIME#33m20s0ms;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 前置、后置配置
IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	IF (stAxis.stAxisStatus.pPremover=0)THEN 
		_pPremover:=ADR(_stAxisNo);
	ELSE
		_pPremover:=stAxis.stAxisStatus.pPremover;
	END_IF
ELSE
	IF (stAxis.stAxisStatus.pAftermover=0)THEN 
		_pPremover:=ADR(_stAxisNo);
	ELSE
		_pPremover:=stAxis.stAxisStatus.pAftermover;
	END_IF
END_IF
// 04.17
(*IF stAxis.stNcTOPLC.nCuRoadID>4 THEN
	_nNextRoadID:=1;
ELSE
	_nNextRoadID:=stAxis.stNcTOPLC.nCuRoadID+1;
END_IF
_eNextRoadDirection:=E_Direction.DIRECTION_NEGATIVE;*)


IF stNextRoadParam.nRoadID<>0 THEN
	_nNextRoadID:=stNextRoadParam.nRoadID;
	IF stNextRoadParam.fEndPosition>stNextRoadParam.fStartPosition  THEN
	    _eNextRoadDirection:=E_Direction.DIRECTION_POSITIVE;
	ELSE
		_eNextRoadDirection:=E_Direction.DIRECTION_NEGATIVE;
	END_IF
END_IF
IF (stAxis.stNcTOPLC.nCuRoadID<>0)THEN
   _fCuRoadLength:=GVL_MC.aRoadRef[stAxis.stNcTOPLC.nCuRoadID].fLength;
  // _fNextRoadLength:=GVL_MC.aRoadRef[_nNextRoadID].fLength;
END_IF
IF _nNextRoadID<>0 THEN
	IF (GVL_MC.aRoadRef[_nNextRoadID].nMoverCounter<>0)THEN
			IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN
				IF (GVL_MC.aRoadRef[_nNextRoadID].pLastAixs^.stNcTOPLC.nAxisId<>stAxis.stNcTOPLC.nAxisId)THEN
				   _pNextRoadmover:=GVL_MC.aRoadRef[_nNextRoadID].pLastAixs;
				ELSE
					 _pNextRoadmover:=ADR(_stAxisNo);
				 END_IF
			ELSE
				IF (GVL_MC.aRoadRef[_nNextRoadID].pFirstAixs^.stNcTOPLC.nAxisId<>stAxis.stNcTOPLC.nAxisId)THEN
				   _pNextRoadmover:=GVL_MC.aRoadRef[_nNextRoadID].pFirstAixs;
				ELSE
					 _pNextRoadmover:=ADR(_stAxisNo);
				END_IF
			END_IF
	ELSE
		   _pNextRoadmover:=ADR(_stAxisNo);
	END_IF 
	 _fNextRoadLength:=GVL_MC.aRoadRef[_nNextRoadID].fLength;
ELSE
	_pNextRoadmover:=ADR(_stAxisNo);
END_IF
//04.19 
IF _nStep>=10 THEN
	stAxis.stAxisStatus.pNextRoadPremover:=_pNextRoadmover;  //03.26
END_IF
//04.19

//04.17

//指令检测
A_CommandCheck();

//状态
(*IF _bCounterTriger THEN 
	_nCycleCount:=_nCycleCount+1;
END_IF*)
// 02.24增加task事件判断
IF (_nStep<>0)THEN 
	_nCycleCount:=_nCycleCount+1;
ELSE
	_nCycleCount:=0;
END_IF

_fCurrentTime:=UDINT_TO_LREAL(stAxis.stAxisStatus.nNcCycleCounter)*GVL_MC.rNcCycle;

IF (_pPremover^.stNcTOPLC.nAxisId<>0)THEN 
	IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		_fRealDis:=_pPremover^.stNcTOPLC.fActPos-stAxis.stNcTOPLC.fActPos;
		IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
			_fRealDis:=_pPremover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stNcTOPLC.fActPos;
		END_IF
		  
	ELSE
		_fRealDis:=stAxis.stNcTOPLC.fActPos-_pPremover^.stNcTOPLC.fActPos;
		IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
			_fRealDis:=stAxis.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stNcTOPLC.fActPos;
		END_IF
	END_IF
ELSE
	IF(_pNextRoadmover^.stNcTOPLC.nAxisId<>0)THEN
		IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
			IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN
				_fRealDis:=_pNextRoadmover^.stNcTOPLC.fActPos+_fCuRoadLength-stAxis.stNcTOPLC.fActPos;
			ELSE
				_fRealDis:=_fCuRoadLength+_fNextRoadLength-_pNextRoadmover^.stNcTOPLC.fActPos-stAxis.stNcTOPLC.fActPos;
			END_IF
		ELSE
			IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN
				_fRealDis:=_pNextRoadmover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fActPos;
			ELSE
				_fRealDis:=_fNextRoadLength-_pNextRoadmover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fActPos;
			END_IF
		END_IF
	ELSE
		_fRealDis:=0;
	END_IF
			
END_IF


// 流程控制
CASE _nStep  OF 
	0:
	  
	   IF NOT bExecute THEN 
		   bError:=FALSE;
		   bCommandAborted:=FALSE;
		   bDone:=FALSE;
		   nErrorId:=0;
		   //_bCounterTriger:=FALSE;
		   _fLastParam_Pos:=0;
           _fLastParam_Vel:=0;
		   _fLastGap:=0;
		   _eCommand:=E_Command.COMMAND_IDLE;
	   
	   END_IF
	 
	   RETURN;
	  
    5:   (***********initialization*******************)
	      
	     A_Init();
	     bBusy:=TRUE;
	     bError:=FALSE;
	     bCommandAborted:=FALSE;
		 bActive:=FALSE;
	     nErrorID:=0;
	     bDone:=FALSE;
		 A_ParamCheck();
		 //03.25 指令打断缓冲
		 IF (stAxis.stPLCTONC.eCommand<>E_Command.COMMAND_ABSOLUTE)THEN
			 IF NOT stAxis.stPLCTONC.bNcStart THEN
				 _nStep:= 10;
			 END_IF
		 ELSE
			 stAxis.stPLCTONC.bNcStart:=FALSE;
		     _nStep:= 10;
		 END_IF
		// stAxis.stPLCTONC.bNcStart:=FALSE;
		 //_nStep:= 10;
		 IF _bParamError  THEN 
			 _nStep:= 100;
			 _bParamError:=FALSE;
		 END_IF
		 
    10:  (*************Path generation****************)
	     bActive:=TRUE;
	     A_PathPreGeneration();
		 stAxis.stAxisStatus.bDiscreteMotion:=TRUE;
		 stAxis.stAxisStatus.bContinuousMotion:=FALSE;
		 stAxis.stAxisStatus.bSynchronizedMotion:=FALSE;
		 stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_ABSOLUTE;
		 _eCommand:=stAxis.stPLCTONC.eCommand;
		 
		// _bCollisionChecked:=FALSE;
		 IF _bPreGeneSegDone THEN 
				 stAxis.stPLCTONC.bNcEnable:=TRUE;
		         stAxis.stPLCTONC.bNcStart:=TRUE;
				 //stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_ABSOLUTE;
				// _eCommand:=stAxis.stPLCTONC.eCommand;
				 stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_TSHAPED;
	             stAxis.stAxisStatus.bMoving:=TRUE;
				 _bCollisionChecked:=FALSE;
			     _bPreGeneSegDone:=FALSE;
				 _bSegOver:=FALSE;
				 IF(_fLastVelocity>_fSetVelo)AND NOT bCollsionNotValid THEN 
					 stAxis.stPLCTONC.bCmdDceUpdate:=TRUE;
				 END_IF
				 _nStep:= _nStep+10;
	             stAxis.stPLCTONC.bEndPosCalDone:=TRUE;    //04.02
				 IF GVL_MC.cDebug  THEN   //04.17
					_sMessage:=FC_StrContact(stAxis,'abs generate path');
					 ADSLOGSTR(ADSLOG_MSGTYPE_HINT, _sMessage, '');
				 END_IF
		 END_IF
		 IF _bSegOver THEN      //防碰撞停止
			_bCollisionChecked:=TRUE;
		 END_IF
		 IF _bSegDone THEN     //当前位置和目标位置一致
			_nStep:=40;
			bBusy:=FALSE;
			bActive:=FALSE;
			bDone:=TRUE;
			_bSegDone:=FALSE;
			stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
			_bCollisionChecked:=FALSE;
			stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
			_eCommand:=E_Command.COMMAND_IDLE;
			RETURN;
		END_IF
		
		IF _bNegPosStop THEN 
			_nStep:= 50;
			_bNegPosStop:=FALSE;
			
		END_IF
		IF _bParamError  THEN 
			 _nStep:= 100;
			 _bParamError:=FALSE;
		END_IF
		
	20:
		 _nStep:= 30;
		  //自动计算nc task和规划task 02.24
		 _nDealtCycleCounter:=_nCycleCount-_nLastCycleCounter;
		 _nDealtNcCycleCounter:=stAxis.stAxisStatus.nNcCycleCounter_WP-_nLastNcCycleCounter;
		 IF (_nDealtCycleCounter< _nDealtNcCycleCounter)THEN
			  stAxis.stPLCTONC.bNcStart:=FALSE;     //12.27
		 END_IF
		 stAxis.stPLCTONC.bEndPosCalDone:=FALSE;    //04.02
	30: 
	    
	    stAxis.stPLCTONC.bNcStart:=FALSE;
		stAxis.stPLCTONC.bCmdDceUpdate:=FALSE;
	
	    IF (stAxis.stNcTOPLC.nAxisState=2)AND (stAxis.stAxisStatus.nNcCycleCounter=0)  THEN   
			
			IF (ABS(LTRUNC(stAxis.stNcTOPLC.fActPos)- LTRUNC(fPosition))>1) THEN  //03.05
				_bTargetDiff:=TRUE;
			END_IF
			IF _bTargetDiff   THEN        // target position have mover 
			    _nStep:=10;
				stAxis.stPLCTONC.bNcStart:=FALSE;
			    stAxis.stPLCTONC.bNcEnable:=FALSE;
			ELSE 
				bDone:=TRUE;
				bBusy:=FALSE;
	            bError:=FALSE;
	            bCommandAborted:=FALSE;
	            nErrorID:=0;
			    bActive:=FALSE;
			    stAxis.stPLCTONC.bNcStart:=FALSE;
			    stAxis.stPLCTONC.bNcEnable:=FALSE;
				
				IF bExecute THEN 
					_nStep:= 0;
		            _nCycleCount:=0;
		            stAxis.stAxisStatus.bMoving:=FALSE;
					stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		            stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
					
		            stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
					_bCollisionChecked:=FALSE;
				ELSE
					_nStep:= _nStep+10;
				END_IF
			END_IF
			
		END_IF
      
		IF NOT bCollsionNotValid AND (stAxis.stNcTOPLC.nAxisState<>2)THEN
			IF (_pPremover^.stNcTOPLC.nAxisId<>0)THEN
			     A_PathUpdateCheck(); 
			ELSE
				IF(_pNextRoadmover^.stNcTOPLC.nAxisId<>0)THEN
			        A_NextPathUpdateCheck();
				ELSE
					_fDyPathDis1:=20;
				END_IF
			END_IF
            _fbDyTrig(CLK:=(_fDyPathDis1>10)AND(_fStartTime<=0.02)AND(stAxis.stPLCTONC.stEndPosition.fPosition<>_fSetPos) , Q=> ); 
			IF _fbDyTrig.Q THEN 
					_nStep:=10;
					_fbDyTrig(CLK:=FALSE , Q=> );
					//_sMessage:=CONCAT(DWORD_TO_STRING(stAxis.stNcTOPLC.nAxisId),'abs dy PathUpdate');
					//ADSLOGSTR(ADSLOG_MSGTYPE_HINT, _sMessage, 'abs dy PathUpdate');
			END_IF
			
		END_IF 
		
		
	40:
       //_fbDoneTon(IN:=TRUE, PT:=tcDoneTime , Q=> , ET=> );
       //IF _fbDoneTon.Q THEN
		 bDone:=FALSE;
		 _fbDoneTon(IN:=FALSE, PT:=tcDoneTime , Q=> , ET=> );
		 _nStep:=0;
		// _bCounterTriger:=FALSE;
		 _nCycleCount:=0;
		 _fLastParam_Pos:=0;
         _fLastParam_Vel:=0;
		 _fLastGap:=0;
		  stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		  stAxis.stAxisStatus.bMoving:=FALSE;
		  stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
		  _eCommand:=E_Command.COMMAND_IDLE;
		  stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
		  _bCollisionChecked:=FALSE;
		  stAxis.stAxisStatus.pNextRoadPremover:=ADR(_stAxisNo);  //04.20
	 //  END_IF	

    // 01/10 新增更新位置计算小于当前位置停止处理
    50:   
	     A_StopPathGerenation();
		 stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_ABSOLUTE;
		 _eCommand:=stAxis.stPLCTONC.eCommand;
		 stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_TSHAPED;
	     stAxis.stPLCTONC.bNcStart:=TRUE;
		 stAxis.stAxisStatus.bStoppingFlag:=TRUE;     
	     _nStep:=_nStep+10;
    60:
	     IF (stAxis.stNcTOPLC.nAxisState=2)THEN
	        _nStep:=10; 
		    stAxis.stPLCTONC.bNcStart:=FALSE;
		    stAxis.stAxisStatus.bStoppingFlag:=FALSE;  
	     END_IF 
	//   01/10 新增更新位置计算小于当前位置停止处理
    
    70:   //去使能

		IF (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN   //08.08
			A_StopPathGerenation();
	        stAxis.stPLCTONC.bNcStart:=TRUE;
			stAxis.stAxisStatus.bStoppingFlag:=TRUE;   //03.04
	        _nStep:=_nStep+10;   
		ELSE     //补位状态
			
			  _nStep:=90;   
		END_IF
    80:
	
	    IF (stAxis.stNcTOPLC.nAxisState=2)THEN
	       _nStep:=90; 
		   stAxis.stPLCTONC.bNcStart:=FALSE;
	
		   stAxis.stAxisStatus.bStoppingFlag:=FALSE;    //03.04
		   
	     END_IF 
		
	90:
	     //_fbDoneTon(IN:=TRUE, PT:=tcDoneTime , Q=> , ET=> );
        // IF _fbDoneTon.Q THEN
		     bCommandAborted:=TRUE;
			 bBusy:=FALSE;
	         bActive:=FALSE;
			 bDone:=FALSE;
			 _fbDoneTon(IN:=FALSE, PT:=tcDoneTime , Q=> , ET=> );
			
			  _nStep:=0;
			//_bCounterTriger :=FALSE;
			 _nCycleCount:=0;
			 _stPathRef.bCalculateDone:=FALSE;
			 
			 _bPathCalDone:=FALSE;
			 _bTargetDiff:=FALSE;
			 _fLastParam_Pos:=0;
             _fLastParam_Vel:=0;
			 _fLastGap:=0;
			 _bCollisionChecked:=FALSE;
			  stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
			  stAxis.stAxisStatus.bMoving:=FALSE;
			  stAxis.stPLCTONC.bNcEnable:=FALSE;
			  stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
			  stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
			  _eCommand:=E_Command.COMMAND_IDLE;
			  stAxis.stPLCTONC.bEndPosCalDone:=FALSE;    //04.02
	     //END_IF	 
	
    100: (************error handle***********)
        bBusy:=FALSE;
	    bError:=TRUE;
	    bActive:=FALSE;
	    bDone:=FALSE;
	    bCommandAborted:=FALSE;
	    stAxis.stAxisStatus.bError:=TRUE;
		stAxis.stAxisStatus.nErrorId:=nErrorID;
	    stAxis.stAxisStatus.bMoving:=FALSE;
	    _bNcStart:=FALSE;
		stAxis.stPLCTONC.bNcStart:=FALSE;
		stAxis.stPLCTONC.bNcEnable:=FALSE;
		stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
		
		stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
		stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
	    _nStep:=0;
		_fLastParam_Pos:=0;
        _fLastParam_Vel:=0;
		_fLastGap:=0;
        _bCollisionChecked:=FALSE;
		stAxis.stAxisStatus.bStoppingFlag:=FALSE;
		_nCycleCount:=0;
		stAxis.stPLCTONC.bEndPosCalDone:=FALSE;    //04.02
		stAxis.stAxisStatus.pNextRoadPremover:=ADR(_stAxisNo);
		(************command aborted***********)  //03.04
    110:
	    bCommandAborted:=TRUE;
		bBusy:=FALSE;
		bDone:=FALSE;
		bActive:=FALSE;
		_nStep:=0; 
		_stPathRef.aExecutablePath:=_aNoPath;
		_bSegOver:=FALSE;
		_nCycleCount:=0;
		stAxis.stAxisStatus.bMoving:=FALSE;
		_bTargetDiff:=FALSE;
		_fLastParam_Pos:=0;
		_fLastParam_Vel:=0;
		_fLastGap:=0;
		//stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		_bCollisionChecked:=FALSE;
	    stAxis.stPLCTONC.bEndPosCalDone:=FALSE;    //04.02
		stAxis.stAxisStatus.pNextRoadPremover:=ADR(_stAxisNo);  //04.20 
END_CASE

A_UpstateStatus();


]]></ST>
    </Implementation>
    <Action Name="A_CommandCheck" Id="{36454701-3661-44b6-a1e6-bb352200fea1}">
      <Implementation>
        <ST><![CDATA[//注意优先级，最下面优先级最高

_fbTrig(CLK:=bExecute , Q=> );
IF _fbTrig.Q  THEN
	IF (NOT stAxis.stAxisStatus.bEnabled) OR stAxis.stAxisStatus.bError OR stAxis.stAxisStatus.bStopping THEN 
		_nStep:=100;
		//bError:=TRUE;
		nErrorID:=29673;
		RETURN;
	END_IF 
	(*IF(_fLastParam_Pos=fPosition) AND (_fLastParam_Vel=fVelocity) AND (_fLastGap=fGap)  THEN   //指令过滤  12.26增加gap判断
		;
	ELSE
		
		_stLastCmdExeParam.eCommand:=stAxis.stPLCTONC.eCommand;
		_stLastCmdExeParam.ePlanningMode:=stAxis.stPLCTONC.ePlanningMode;
		_stLastCmdExeParam.fTargetVelocity:=stAxis.stPLCTONC.fTargetVelocity;
		_stLastCmdExeParam.stStartPosition:=stAxis.stPLCTONC.stStartPosition;
		_stLastCmdExeParam.stEndPosition:=stAxis.stPLCTONC.stEndPosition;
		_nStep:=5;
	   // _bCounterTriger:=TRUE;
	    _nCycleCount:=0;
		
	END_IF*)// 03.25
	_stLastCmdExeParam.eCommand:=stAxis.stPLCTONC.eCommand;
		_stLastCmdExeParam.ePlanningMode:=stAxis.stPLCTONC.ePlanningMode;
		_stLastCmdExeParam.fTargetVelocity:=stAxis.stPLCTONC.fTargetVelocity;
		_stLastCmdExeParam.stStartPosition:=stAxis.stPLCTONC.stStartPosition;
		_stLastCmdExeParam.stEndPosition:=stAxis.stPLCTONC.stEndPosition;
		_nStep:=5;
	   // _bCounterTriger:=TRUE;
	    _nCycleCount:=0;
END_IF

//command aborted  

IF (stAxis.stPLCTONC.eCommand<>E_Command.COMMAND_ABSOLUTE) AND (_nStep<>0)AND(_eCommand=E_Command.COMMAND_ABSOLUTE)THEN 
	_nStep:=110;
END_IF

// 前动子异常
_fbPreMoveErrTrig(CLK:=_pPremover^.stAxisStatus.bError AND (_fRealDis<=(_fGap+0.5*_pPremover^.stAxisParam.fClampLength))   , Q=> );
IF _fbPreMoveErrTrig.Q THEN 
	IF (_nStep=0) THEN  
			bBusy:=FALSE;
			bDone:=FALSE;
			bActive:=FALSE;
			_nStep:=0; 
			_stPathRef.aExecutablePath:=_aNoPath;
			//_bCounterTriger:=FALSE;
			_nCycleCount:=0;
			stAxis.stAxisStatus.bMoving:=FALSE;
			_bTargetDiff:=FALSE;
			_fLastParam_Pos:=0;
            _fLastParam_Vel:=0;
			_fLastGap:=0;
			stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
			_bCollisionChecked:=FALSE;
	ELSE
		_nStep:=70;
	END_IF
	 
END_IF


//disEnable 
_fbEnbleTrig(CLK:=stAxis.stAxisStatus.bEnabled , Q=> );
IF _fbEnbleTrig.Q THEN 
	//bCommandAborted:=TRUE;
	IF (_nStep=0) THEN 
			bBusy:=FALSE;
			bDone:=FALSE;
			bActive:=FALSE;
			_stPathRef.aExecutablePath:=_aNoPath;
			_nCycleCount:=0;
			_bTargetDiff:=FALSE;
			_fLastParam_Pos:=0;
            _fLastParam_Vel:=0;
			_fLastGap:=0;
			_bCollisionChecked:=FALSE;
			
	ELSE
		//_nStep:=70;
		_nStep:=90;
	END_IF
	 
END_IF









]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Init" Id="{15360220-783d-410f-8f99-5a2175630467}">
      <Implementation>
        <ST><![CDATA[_nCycleCount:=0;
//_bStartSametime:=FALSE;
_bSegOver:=FALSE;
_bPreGeneSegDone:=FALSE;
//_bSameVelo:=FALSE;
//_bPathSafe:=FALSE; 
_bCollisionChecked:=FALSE;
_bPathCalDone:=FALSE;
//_stPathRef.bCalculateDone:=FALSE;
_fDistance:=0;
_fPrePosition:=0;
//_bAutoFillIn :=FALSE;

//_bDyPathCalOk:=FALSE;
//_bDyPathUpdate:=FALSE;

 _bPreGeneSegDone:=false;

_fDyPathDis1:=0;
_fDyPathDis2:=0;
(**********路径清除**************)

 //_stPathRef.aExecutablePath:=_aNoPath;
//_stPathRef.aSafePath:=_aNoPath;
//_stPathRef.aPreplannedPath:=_aNoPath;

//_stPathRef:=_stNoPathRef;
//_stPrePathRef:=_stNoPathRef;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MeasureIn" Id="{1aed0479-bf0f-479b-8c44-4babaca7b007}">
      <Implementation>
        <ST><![CDATA[
IF ABS(fVelocity)>stAxis.stAxisParam.stDynamicDefault.fMaxVelocity THEN 
	_fSetVelo:= stAxis.stAxisParam.stDynamicDefault.fMaxVelocity ;
ELSE
	_fSetVelo:= ABS(fVelocity) ;
END_IF


_fSetPos:= fPosition ;

_fClampLength:=ABS(stAxis.stAxisParam.fClampLength*0.5);
IF (fGap<>0)THEN 
   _fGap :=_fClampLength+ABS(fGap);
     
ELSE
  _fGap :=_fClampLength+ABS(stAxis.stAxisParam.fGap);

END_IF

IF (fAcceleration=0) THEN 
	_fAcc:=stAxis.stAxisParam.stDynamicDefault.fDefaultAccelaration;
ELSE
	_fAcc:=ABS(fAcceleration);
	IF (fAcceleration>stAxis.stAxisParam.stDynamicDefault.fMaxAccelaration)THEN
		_fAcc:=stAxis.stAxisParam.stDynamicDefault.fMaxAccelaration;
	END_IF
END_IF


IF (fDeceleration=0) THEN
   _fDec:=stAxis.stAxisParam.stDynamicDefault.fDefaultDeceleration;
ELSE 
	_fDec:=ABS(fDeceleration);
	IF (fDeceleration>stAxis.stAxisParam.stDynamicDefault.fMaxDeceleration)THEN
		_fDec:=stAxis.stAxisParam.stDynamicDefault.fMaxDeceleration;
	END_IF
END_IF

IF (_fAcc<>_fDec)THEN
	_fDec:=_fAcc;
END_IF

_nSysType:=stAxis.stAxisParam.stRoadParam.nSysType;
//_eTrackType:=_nSysType;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_NextPathUpdateCheck" Id="{27f7d417-33aa-4398-b22b-236bb6af5637}">
      <Implementation>
        <ST><![CDATA[IF (_pNextRoadmover^.stPLCTONC.nRoadID_1<>0)THEN  //跨路段指令
		IF(_pNextRoadmover^.stAxisStatus.nNcCycleCounter=0)THEN
			IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
				IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
					_fNeRoadMoverPos:=_fCuRoadLength +_pNextRoadmover^.stNcTOPLC.fActPos-_pNextRoadmover^.stAxisParam.fClampLength*0.5-_fGap;
				ELSE
					_fNeRoadMoverPos:=_fCuRoadLength +_fNextRoadLength-(_pNextRoadmover^.stNcTOPLC.fActPos+_pNextRoadmover^.stAxisParam.fClampLength*0.5+_fGap);	
				END_IF
				_fDyPathDis1:= _fNeRoadMoverPos-stAxis.stPLCTONC.stEndPosition.fPosition;
						
			ELSE
				IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
					_fNeRoadMoverPos:=_pNextRoadmover^.stNcTOPLC.fActPos-_pNextRoadmover^.stAxisParam.fClampLength*0.5-_fGap;
				ELSE
					_fNeRoadMoverPos:=_fNextRoadLength-(_pNextRoadmover^.stNcTOPLC.fActPos+_pNextRoadmover^.stAxisParam.fClampLength*0.5+_fGap);
				END_IF
				_fDyPathDis1:= stAxis.stPLCTONC.stEndPosition.fPosition+_fNeRoadMoverPos;			
			END_IF 	
		ELSE
		  IF (_pNextRoadmover^.stPLCTONC.stStartPosition.nRoadID=stAxis.stNcTOPLC.nCuRoadID) THEN   //起始路段与当期路段相同
				IF (_pNextRoadmover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN 
						IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
							_fNeRoadMoverPos:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap;
							_fDyPathDis1:= _fNeRoadMoverPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos;
						ELSE
							 _fNeRoadMoverPos:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+_fGap;
							_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fNeRoadMoverPos;				
						END_IF 
				ELSIF (_pNextRoadmover^.stAxisStatus.stPathRef._nPathSegmentNum=2)THEN
						IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
							_fNeRoadMoverPos:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap;
							_fDyPathDis1:= _fNeRoadMoverPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos;
						ELSE
							 _fNeRoadMoverPos:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos+_fGap;
							_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fNeRoadMoverPos;				
						END_IF 
				ELSE
					;
				END_IF
		  ELSE  //起始路段与当期路段不相同
			   IF (_pNextRoadmover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN 
						IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
							IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
								_fNeRoadMoverPos:=_fCuRoadLength+(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap);
							ELSE
								_fNeRoadMoverPos:=_fCuRoadLength+_fNextRoadLength-(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+_fGap);
							END_IF
							_fDyPathDis1:= _fNeRoadMoverPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos;
						ELSE
							IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
								_fNeRoadMoverPos:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap;
							ELSE
								_fNeRoadMoverPos:=_fNextRoadLength-(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+_fGap);
							END_IF
							_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+_fNeRoadMoverPos;				
						END_IF 
				ELSIF (_pNextRoadmover^.stAxisStatus.stPathRef._nPathSegmentNum=2)THEN
					
						IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
							IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
								_fNeRoadMoverPos:=_fCuRoadLength+(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap);
							ELSE
								_fNeRoadMoverPos:=_fCuRoadLength+_fNextRoadLength-(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos+_fGap);
							END_IF
							_fDyPathDis1:= _fNeRoadMoverPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos;
						ELSE
							IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
								_fNeRoadMoverPos:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap;
							ELSE
								_fNeRoadMoverPos:=_fNextRoadLength-(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos+_fGap);
							 END_IF
							_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+_fNeRoadMoverPos;				
						END_IF 
				ELSE
					;
				END_IF
		   END_IF
		END_IF
ELSE   //非跨路段指令
	IF(_pNextRoadmover^.stAxisStatus.nNcCycleCounter=0)THEN
			IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
				IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
					_fNeRoadMoverPos:=_fCuRoadLength +_pNextRoadmover^.stNcTOPLC.fActPos-_pNextRoadmover^.stAxisParam.fClampLength*0.5-_fGap;
				ELSE
					_fNeRoadMoverPos:=_fCuRoadLength +_fNextRoadLength-(_pNextRoadmover^.stNcTOPLC.fActPos+_pNextRoadmover^.stAxisParam.fClampLength*0.5+_fGap);	
				END_IF
				_fDyPathDis1:= _fNeRoadMoverPos-stAxis.stPLCTONC.stEndPosition.fPosition;
						
			ELSE
				IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
					_fNeRoadMoverPos:=_pNextRoadmover^.stNcTOPLC.fActPos-_pNextRoadmover^.stAxisParam.fClampLength*0.5-_fGap;
				ELSE
					_fNeRoadMoverPos:=_fNextRoadLength-(_pNextRoadmover^.stNcTOPLC.fActPos+_pNextRoadmover^.stAxisParam.fClampLength*0.5+_fGap);
				END_IF
				_fDyPathDis1:= stAxis.stPLCTONC.stEndPosition.fPosition+_fNeRoadMoverPos;			
			END_IF 	
	ELSE
			IF (_pNextRoadmover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN 
					IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
						IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
							_fNeRoadMoverPos:=_fCuRoadLength+(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap);
						ELSE
							_fNeRoadMoverPos:=_fCuRoadLength+_fNextRoadLength-(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+_fGap);
						END_IF
						_fDyPathDis1:= _fNeRoadMoverPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos;
					ELSE
						IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
							_fNeRoadMoverPos:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap;
						ELSE
							_fNeRoadMoverPos:=_fNextRoadLength-(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+_fGap);
						 END_IF
						_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+_fNeRoadMoverPos;				
					END_IF 
			ELSIF (_pNextRoadmover^.stAxisStatus.stPathRef._nPathSegmentNum=2)THEN
				
					IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
						IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
							_fNeRoadMoverPos:=_fCuRoadLength+(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap);
						ELSE
							_fNeRoadMoverPos:=_fCuRoadLength+_fNextRoadLength-(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos+_fGap);
						END_IF
						_fDyPathDis1:= _fNeRoadMoverPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos;
					ELSE
						IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN 
							_fNeRoadMoverPos:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap;
						ELSE
							_fNeRoadMoverPos:=_fNextRoadLength-(_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos+_fGap);
						 END_IF
						_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+_fNeRoadMoverPos;				
					END_IF 
			ELSE
				;
			END_IF
	END_IF

END_IF


IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN 
   _fStartTime:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTotalTime-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTd-_fCurrentTime;
  
ELSIF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=2)THEN 
	_fStartTime:=stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fTotalTime-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fTd-_fCurrentTime;
ELSE
	;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_NextRoadMoverCheck" Id="{620d1790-8d31-4acc-be2e-ec4f1e76c917}">
      <Implementation>
        <ST><![CDATA[// 动子分为运动和停止状态
// 细分动子在road1和road2两种情况,静止状态动子一定再road2上面
//运动情况 
// 先计算距离 后坐标转换
IF (_pNextRoadmover^.stPLCTONC.nRoadID_1<>0)THEN   //03.21 指令判断
	IF (_pNextRoadmover^.stPLCTONC.stStartPosition.nRoadID=stAxis.stNcTOPLC.nCuRoadID)THEN// 起点road2
			IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN
				   _fPrePositionTemp:=FC_FindPosition(pPathData:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath )-_fGap;
				   _fPrePosition:=FC_TransformPosition(fOffset:=-_fCuRoadLength , fPosition:=_fPrePositionTemp );    //坐标转换;
			ELSE
				  _fPrePositionTemp:=FC_FindPosition(pPathData:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath )+_fGap;
				  _fPrePosition:=FC_TransformPosition(fOffset:=0 , fPosition:=-_fPrePositionTemp );    //坐标转换;
			END_IF
				
	ELSE   // 起点road2,坐标不做转换
				  //运动情况 
			IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN
				_fPrePositionTemp:=FC_FindPosition(pPathData:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath )-_fGap;
				_fPrePosition:=_fPrePositionTemp;
			ELSE
				_fPrePositionTemp:=FC_FindPosition(pPathData:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath )+_fGap;
				_fPrePosition:=_fNextRoadLength-_fPrePositionTemp;
				
		   END_IF	
	END_IF
ELSE
	IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN
		_fPrePositionTemp:=FC_FindPosition(pPathData:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath )-_fGap;
		_fPrePosition:=_fPrePositionTemp;
	ELSE
		_fPrePositionTemp:=FC_FindPosition(pPathData:=_pNextRoadmover^.stAxisStatus.stPathRef.aSafePath )+_fGap;
		_fPrePosition:=_fNextRoadLength-_fPrePositionTemp;
    END_IF

END_IF

//静止情况 只有road2
IF (_pNextRoadmover^.stAxisStatus.nNcCycleCounter=0)THEN      //premover is not ready	
	IF (_eNextRoadDirection=E_Direction.DIRECTION_POSITIVE)THEN
		_fPrePosition:=_pNextRoadmover^.stNcTOPLC.fActPos-_pNextRoadmover^.stAxisParam.fClampLength*0.5-_fGap;
	ELSE
		_fPrePosition:=_fNextRoadLength-(_pNextRoadmover^.stNcTOPLC.fActPos+_pNextRoadmover^.stAxisParam.fClampLength*0.5+_fGap);
	END_IF
	
END_IF

//根据方向分4种情况讨论可达位置	    
IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	
	_fNextNewPrePosition:=FC_TransformPosition(fOffset:=_fCuRoadLength , fPosition:=_fPrePosition );    //坐标转换
	IF (_fNextNewPrePosition>_fSetPos)THEN
		_fNewPrePosition:=_fSetPos;
    ELSE
		_fNewPrePosition:=_fNextNewPrePosition;
    END_IF
	
ELSE
	
	_fNextNewPrePosition:=FC_TransformPosition(fOffset:=0 , fPosition:=-_fPrePosition );    //坐标转换
    IF (_fNextNewPrePosition<_fSetPos)THEN
		_fNewPrePosition:=_fSetPos;
    ELSE
		_fNewPrePosition:=_fNextNewPrePosition;
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_ParamCheck" Id="{96ba1b3e-d3de-46d5-8815-c885a6c56bc2}">
      <Implementation>
        <ST><![CDATA[A_MeasureIn();

(*IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	IF (fPosition<stAxis.stNcTOPLC.fActPos)THEN
		 _bParamError:=TRUE;
		 nErrorID:=29678;
		 RETURN;
	END_IF
ELSE
	IF (fPosition>stAxis.stNcTOPLC.fActPos)THEN
		 _bParamError:=TRUE;
		  nErrorID:=29679;
		 RETURN;
	END_IF
END_IF*)
IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	//IF (fPosition<stAxis.stNcTOPLC.fActPos)THEN  //04.29
	IF (fPosition<(stAxis.stNcTOPLC.fActPos-1))THEN  //04.29
		 _bParamError:=TRUE;
		 nErrorID:=29678;
		 RETURN;
	END_IF
ELSE
	//IF (fPosition>stAxis.stNcTOPLC.fActPos)THEN   //04.29
	IF (fPosition>(stAxis.stNcTOPLC.fActPos+1))THEN   //04.29 计算误差
		 _bParamError:=TRUE;
		  nErrorID:=29679;
		 RETURN;
	END_IF
END_IF
IF (fPosition<>0) AND (fVelocity=0) THEN       // param error 
	 _bParamError:=TRUE;
	 nErrorID:=29680;
	 RETURN;
END_IF

///04.20  增加roaid 判断
IF (_pPremover^.stNcTOPLC.nAxisId<>0)  THEN
	IF stAxis.stNcTOPLC.nCuRoadID<>_pPremover^.stNcTOPLC.nCuRoadID THEN 
		 _bParamError:=TRUE;
	      nErrorID:=29682;
	     RETURN;
	END_IF
END_IF

IF(_pNextRoadmover^.stNcTOPLC.nAxisId<>0)THEN
	IF stAxis.stNcTOPLC.nCuRoadID=_pNextRoadmover^.stNcTOPLC.nCuRoadID THEN 
		 _bParamError:=TRUE;
	      nErrorID:=29683;
	     RETURN;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_PathPreGeneration" Id="{b7924af5-934e-4515-9e83-3cc89a1f4d98}">
      <Implementation>
        <ST><![CDATA[_fLastParam_Pos:=fPosition;
_fLastParam_Vel:=fVelocity;

_fLastVelocity:=stAxis.stAxisStatus.stPathRef.fTargetVelocity;

stAxis.stPLCTONC.stStartPosition.fPosition:=stAxis.stNcTOPLC.fActPos;
stAxis.stPLCTONC.stStartPosition.fVelocity:=stAxis.stNcTOPLC.fActVelo;
stAxis.stPLCTONC.stStartPosition.fAccleration:=_fAcc;
stAxis.stPLCTONC.stStartPosition.fDeceleration:=_fDec;
stAxis.stPLCTONC.stStartPosition.fbJerk:=fJerk;
stAxis.stPLCTONC.stStartPosition.nRoadID:=stAxis.stNcTOPLC.nCuRoadID;   //02.20


stAxis.stPLCTONC.fTargetVelocity:=_fSetVelo;
stAxis.stPLCTONC.fSetVelocity:=_fSetVelo;  //04.25
stAxis.stPLCTONC.fTargetPos:=fPosition;   //03.20
stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
stAxis.stPLCTONC.stEndPosition.fAccleration:=_fAcc;
stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;
stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk;
stAxis.stPLCTONC.stEndPosition.nRoadID:=stAxis.stNcTOPLC.nCuRoadID;   //02.20

stAxis.stPLCTONC.nSysType:=_nSysType;
IF (_nSysType=1)OR (_nSysType=4) THEN 
	stAxis.stPLCTONC.nSysType:=2;
END_IF

stAxis.stAxisStatus.stPathRef.fGap:=_fClampLength;
stAxis.stAxisStatus.stPathRef.fSetGap:=_fGap;


stAxis.stPLCTONC.fRoad1_Length:=_fCuRoadLength;  //05.24
stAxis.stPLCTONC.fRoad2_Length:=_fNextRoadLength; // 05.24
// 是否成组判断，并根据条件计算组内gap距离  03.31
IF (_pPremover^.stNcTOPLC.nAxisId<>0)  THEN 
	IF (_pPremover^.stAxisStatus.stGroupRef.eGroupType<>E_GroupType.GROUPTYPE_NONE)
           AND (stAxis.stAxisStatus.stGroupRef.eGroupType<>E_GroupType.GROUPTYPE_NONE)THEN 
		IF (_pPremover^.stAxisStatus.stGroupRef.nGroupId=stAxis.stAxisStatus.stGroupRef.nGroupId)THEN
            IF NOT _bIsGroupMember THEN
			    _fGroupInGap:=LTRUNC(ABS(_pPremover^.stNcTOPLC.fActPos-stAxis.stNcTOPLC.fActPos));
			    
			END_IF
			//stAxis.stAxisStatus.stPathRef.fGroupInGap:=_fGroupInGap;
			stAxis.stPLCTONC.fGroupInGap:=_fGroupInGap;
			_bIsGroupMember:=TRUE;
		END_IF
	ELSE
		_bIsGroupMember:=FALSE;
	END_IF
ELSE
	_bIsGroupMember:=FALSE;
END_IF
// 判断如果成组，实际位置超过规划位置，按实际物理位置作为起点规划路径
IF _bIsGroupMember THEN 
	IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
        IF (stAxis.stNcTOPLC.fModuloSetPos<stAxis.stCodToNCParam.fActualPos)THEN 
			stAxis.stPLCTONC.stStartPosition.fPosition:=stAxis.stNcTOPLC.fActPos;
		END_IF
	ELSE
		IF (stAxis.stNcTOPLC.fModuloSetPos<stAxis.stCodToNCParam.fActualPos)THEN 
			stAxis.stPLCTONC.stStartPosition.fPosition:=stAxis.stNcTOPLC.fActPos;
		END_IF
    END_IF
END_IF


(******************save premover path ***************)
IF (_pPremover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid THEN
	
	IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		
		(*_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aSafePath )-_fGap;
		IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle positive move
			_fPrePosition:=_fPrePosition+stAxis.stNcTOPLC.fModuloFactor;
		END_IF 
		IF _bIsGroupMember THEN   //03.31  重新计算组内可达位置
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath)-_fGroupInGap;
		END_IF*)  //04.14注释
		IF _pPremover^.stAxisStatus.bPositiveDirection THEN 
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aSafePath )-_fGap;
			IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle positive move
				_fPrePosition:=_fPrePosition+stAxis.stNcTOPLC.fModuloFactor;
			END_IF 
			IF _bIsGroupMember THEN   //03.31  重新计算组内可达位置
				_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath)-_fGroupInGap;
			END_IF
		ELSE
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath)-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
			IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle positive move
				_fPrePosition:=_fPrePosition+stAxis.stNcTOPLC.fModuloFactor;
			END_IF 
			
		END_IF
		_fPrePositionTemp:=_fPrePosition;
    ELSE
		
		(*_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aSafePath )+_fGap;
		IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle negative  move
			_fPrePosition:=_fPrePosition-stAxis.stNcTOPLC.fModuloFactor;
		     
		END_IF
		IF _bIsGroupMember THEN   //03.31  重新计算组内可达位置
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath)+_fGroupInGap;
		END_IF
	    _fPrePositionTemp:=_fPrePosition;*) //04.15注释
		IF _pPremover^.stAxisStatus.bNegativeDirection THEN // 负向
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aSafePath )+_fGap;
			IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle negative  move
				_fPrePosition:=_fPrePosition-stAxis.stNcTOPLC.fModuloFactor;
				 
			END_IF
			IF _bIsGroupMember THEN   //03.31  重新计算组内可达位置
				_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath)+_fGroupInGap;
			END_IF
		ELSE
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath )+_pPremover^.stAxisParam.fClampLength*0.5+_fGap;
			IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle negative  move
				_fPrePosition:=_fPrePosition-stAxis.stNcTOPLC.fModuloFactor;
				 
			END_IF
		END_IF
		_fPrePositionTemp:=_fPrePosition;
	END_IF
    
	IF (_pPremover^.stAxisStatus.nNcCycleCounter=0)THEN      //premover is not ready	
		IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
				_fPrePosition:=_pPremover^.stNcTOPLC.fActPos-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
				IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN 
				    _fPrePosition:=_pPremover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
                END_IF
				IF _bIsGroupMember THEN   //03.31  重新计算组内可达位置
					_fPrePosition:=_pPremover^.stNcTOPLC.fActPos-_fGroupInGap;
				END_IF
				IF (_fPrePosition<=stAxis.stNcTOPLC.fActPos)AND(_fPrePosition<_fSetPos)THEN  //11/26
					
					(*_bSegOver:=TRUE;
					IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
						//_bParamError:=TRUE;
						// nErrorID:=29681;
						_bNegPosStop:=TRUE;
						_fLastGap:=fGap;
					END_IF
					RETURN; *)  //04.0注释
					IF NOT _bIsGroupMember THEN   //04.02 
						_bSegOver:=TRUE;
						IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
							_bNegPosStop:=TRUE;
							_fLastGap:=fGap;
						END_IF
						RETURN; 
					ELSE
						IF _pPremover^.stPLCTONC.bEndPosCalDone AND(stAxis.stAxisStatus.nNcCycleCounter=0)THEN 
							IF _fSetPos>(_pPremover^.stPLCTONC.stEndPosition.fPosition-_fGroupInGap) THEN 
								 _fPrePosition:=_pPremover^.stPLCTONC.stEndPosition.fPosition-_fGroupInGap;
							ELSE
								_fPrePosition:=_fSetPos;
							END_IF
						ELSE
	                        _bSegOver:=TRUE;
							IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
								_bNegPosStop:=TRUE;
								_fLastGap:=fGap;
							END_IF
							RETURN;
						END_IF
					END_IF
				END_IF
		ELSE
				_fPrePosition:=_pPremover^.stNcTOPLC.fActPos+_pPremover^.stAxisParam.fClampLength*0.5+_fGap;
				IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle negative  move 
					_fPrePosition:=_pPremover^.stNcTOPLC.fActPos-stAxis.stNcTOPLC.fModuloFactor+_pPremover^.stAxisParam.fClampLength*0.5+_fGap;
				END_IF
			    IF _bIsGroupMember THEN   //03.31  重新计算组内可达位置
					_fPrePosition:=_pPremover^.stNcTOPLC.fActPos+_fGroupInGap;
				END_IF
			//IF (_fPrePosition>=stAxis.stNcTOPLC.fActPos)THEN  //11.26
				IF (_fPrePosition>=stAxis.stNcTOPLC.fActPos)AND (_fPrePosition>_fSetPos) THEN //11.26
					(*_bSegOver:=TRUE;
					IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
						//_bParamError:=TRUE;
						// nErrorID:=29681;
						 _bNegPosStop:=TRUE;
						_fLastGap:=fGap;
					END_IF
					RETURN;*) //04.02注释
                    IF NOT  _bIsGroupMember THEN   //04.02 
						_bSegOver:=TRUE;
						IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
							_bNegPosStop:=TRUE;
							_fLastGap:=fGap;
						END_IF
						RETURN; 
					ELSE
						IF _pPremover^.stPLCTONC.bEndPosCalDone AND(stAxis.stAxisStatus.nNcCycleCounter=0)THEN 
							IF _fSetPos<(_pPremover^.stPLCTONC.stEndPosition.fPosition+_fGroupInGap) THEN 
								 _fPrePosition:=_pPremover^.stPLCTONC.stEndPosition.fPosition+_fGroupInGap;
							ELSE
								_fPrePosition:=_fSetPos;
							END_IF
						ELSE
	                        _bSegOver:=TRUE;
							IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
								_bNegPosStop:=TRUE;
								_fLastGap:=fGap;
							END_IF
							RETURN;
						END_IF
					END_IF 
				END_IF
			
		END_IF
		
	END_IF
	
	
	IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		IF (_fSetPos<=_fPrePosition)THEN
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fSetPos;
		ELSE
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fPrePosition;
		END_IF
	ELSE
		IF(_fSetPos>_fPrePosition)THEN
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fSetPos;
		ELSE
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fPrePosition;
		END_IF
	END_IF
	stAxis.stPLCTONC.fTargetVelocity:=_fSetVelo;
	
    stAxis.stPLCTONC.stEndPosition.fAccleration:=_fAcc;
    stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;
    stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk;
	IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	    _fDistance:=stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition;
	ELSE
		_fDistance:=ABS(stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition);
	END_IF
	
	IF (_fDistance<=0) THEN      //11.26
		
		IF (LTRUNC(stAxis.stPLCTONC.stEndPosition.fPosition)=LTRUNC(_fSetPos))THEN
			_bSegDone:=TRUE;
		     RETURN ;
		ELSE
			_bSegOver:=TRUE;
		    RETURN ;
		END_IF
		IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
			// _bParamError:=TRUE;
	        // nErrorID:=29681;
			_bNegPosStop:=TRUE;
			_fLastGap:=fGap;
	    END_IF
	END_IF

ELSE
	IF(_pNextRoadmover^.stNcTOPLC.nAxisId=0)THEN
		stAxis.stPLCTONC.stEndPosition.fPosition:=_fSetPos;
		stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
		stAxis.stPLCTONC.stEndPosition.fAccleration:=_fAcc;
		stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;
		stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk;
		IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
			_fDistance:=stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition;
		ELSE
			_fDistance:=ABS(stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition);
		END_IF
		
		IF (_fDistance<=0) THEN 
			_bSegDone:=TRUE;
			RETURN ;
		END_IF
	 ELSE //nextroad   04.18
		 A_NextRoadMoverCheck();
		 stAxis.stPLCTONC.stEndPosition.fPosition:=_fNewPrePosition;
		 stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
		 stAxis.stPLCTONC.stEndPosition.fAccleration:=_fAcc;
		 stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;
		 stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk;
		 IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
			_fDistance:=stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition;
		 ELSE
			_fDistance:=ABS(stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition);
		 END_IF
		
		 IF (_fDistance<=0) THEN 
			//_bSegDone:=TRUE;
			//RETURN ;
			IF (LTRUNC(stAxis.stPLCTONC.stEndPosition.fPosition)=LTRUNC(_fSetPos))THEN
				_bSegDone:=TRUE;
				 RETURN ;
			ELSE
				_bSegOver:=TRUE;
				RETURN ;
			END_IF
		 END_IF
		 
	 END_IF
END_IF 
//_fGapSet:=_pPremover^.stAxisStatus.stPathRef.fGap+stAxis.stAxisParam.fClampLength*0.5;
(*判断当前动子和前动子的间距
   1. <设定阀值，如果速度不相等，将当前动子速度设置为前动子速度
   2. >设定阀值，等待间距拉开 
*)
IF (_pPremover^.stNcTOPLC.nAxisId<>0) THEN 
   _fGapSet:=_pPremover^.stAxisParam.fClampLength*0.5 +_fGap;
ELSE
	IF(_pNextRoadmover^.stNcTOPLC.nAxisId<>0)THEN
		_fGapSet:=_pNextRoadmover^.stAxisParam.fClampLength*0.5 +_fGap;
	ELSE
	   _fGapSet:=0;
	END_IF
    
END_IF

IF _bIsGroupMember THEN   //03.31  重新更新_fGapSet 控制前后动子的间距
	_fGapSet:=_fGroupInGap*0.5;
END_IF

(*IF (_pPremover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid  AND (stAxis.stAxisStatus.nNcCycleCounter=0)   THEN    //01.15
	//IF (ABS(_fRealDis-_fGapSet)<fDealtGap)THEN   //02.20 注释
	IF (_fRealDis>=_fGapSet) THEN  //02.20 保证前动子路径动态更新
		IF (_fRealDis<=(_fGapSet+fDealtGap))THEN
			 IF (stAxis.stPLCTONC.fTargetVelocity>_pPremover^.stPLCTONC.fTargetVelocity)AND(_pPremover^.stPLCTONC.fTargetVelocity<>0)THEN
				
				stAxis.stPLCTONC.fTargetVelocity:=_pPremover^.stPLCTONC.fTargetVelocity;
				
			 END_IF
		END_IF
	ELSE
		RETURN ;
	END_IF
ELSE  //判断下一路段
	IF (_pNextRoadmover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid  AND (stAxis.stAxisStatus.nNcCycleCounter=0)THEN
		IF (_fRealDis>=_fGapSet) THEN  //02.20 保证前动子路径动态更新
			IF (_fRealDis<=(_fGapSet+fDealtGap))THEN
					 IF (stAxis.stPLCTONC.fTargetVelocity>_pNextRoadmover^.stPLCTONC.fTargetVelocity)AND(_pNextRoadmover^.stPLCTONC.fTargetVelocity<>0)THEN
						
						stAxis.stPLCTONC.fTargetVelocity:=_pNextRoadmover^.stPLCTONC.fTargetVelocity;
						
					 END_IF
				END_IF
			ELSE
				RETURN ;
			END_IF
	END_IF
END_IF*)  //07.02

IF (_pPremover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid  AND (stAxis.stAxisStatus.nNcCycleCounter=0)   THEN    //01.15
	IF (_fRealDis>=_fGapSet) THEN
		stAxis.stPLCTONC.fDealtGap:=_fRealDis-_fGapSet+fDealtGap+0.5*_pPremover^.stPLCTONC.fTargetVelocity*_pPremover^.stPLCTONC.fTargetVelocity/_fDec;   //计算dealtGap 06.30
		IF  stAxis.stPLCTONC.fDealtGap<>0 THEN 
			IF (_fRealDis<=(_fGapSet+stAxis.stPLCTONC.fDealtGap))THEN
				IF (stAxis.stPLCTONC.fTargetVelocity>_pPremover^.stPLCTONC.fTargetVelocity)AND(_pPremover^.stPLCTONC.fTargetVelocity<>0)THEN
					stAxis.stPLCTONC.fTargetVelocity:=_pPremover^.stPLCTONC.fTargetVelocity;
				END_IF
			END_IF
		ELSE
			IF (_fRealDis<=(_fGapSet+fDealtGap))THEN
				IF (stAxis.stPLCTONC.fTargetVelocity>_pPremover^.stPLCTONC.fTargetVelocity)AND(_pPremover^.stPLCTONC.fTargetVelocity<>0)THEN
					stAxis.stPLCTONC.fTargetVelocity:=_pPremover^.stPLCTONC.fTargetVelocity;
				END_IF
			END_IF
		END_IF
		(*IF (_fRealDis<=(_fGapSet+fDealtGap))THEN
			IF (stAxis.stPLCTONC.fTargetVelocity>_pPremover^.stPLCTONC.fTargetVelocity)AND(_pPremover^.stPLCTONC.fTargetVelocity<>0)THEN
				stAxis.stPLCTONC.fTargetVelocity:=_pPremover^.stPLCTONC.fTargetVelocity;
			END_IF
	    END_IF*)  //06.30
	ELSE
		RETURN ;
	END_IF
ELSE
	// 03.18增加下一段距离判断
	IF (_pNextRoadmover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid  AND (stAxis.stAxisStatus.nNcCycleCounter=0)   THEN    //01.15
		IF (_fRealDis>=_fGapSet) THEN
			stAxis.stPLCTONC.fDealtGap:=_fRealDis-_fGapSet+fDealtGap+0.5*_pNextRoadmover^.stPLCTONC.fTargetVelocity*_pNextRoadmover^.stPLCTONC.fTargetVelocity/_fDec;   //计算dealtGap 06.30
			IF  stAxis.stPLCTONC.fDealtGap<>0 THEN 
				IF (_fRealDis<=(_fGapSet+stAxis.stPLCTONC.fDealtGap))THEN
					IF (stAxis.stPLCTONC.fTargetVelocity>_pNextRoadmover^.stPLCTONC.fTargetVelocity)AND(_pNextRoadmover^.stPLCTONC.fTargetVelocity<>0)THEN
						stAxis.stPLCTONC.fTargetVelocity:=_pNextRoadmover^.stPLCTONC.fTargetVelocity;
					END_IF
				END_IF
			ELSE
				IF (_fRealDis<=(_fGapSet+fDealtGap))THEN
					IF (stAxis.stPLCTONC.fTargetVelocity>_pNextRoadmover^.stPLCTONC.fTargetVelocity)AND(_pNextRoadmover^.stPLCTONC.fTargetVelocity<>0)THEN
						stAxis.stPLCTONC.fTargetVelocity:=_pNextRoadmover^.stPLCTONC.fTargetVelocity;
					END_IF
				END_IF
			END_IF
			(*IF (_fRealDis<=(_fGapSet+fDealtGap))THEN
				IF (stAxis.stPLCTONC.fTargetVelocity>_pNextRoadmover^.stPLCTONC.fTargetVelocity)AND(_pNextRoadmover^.stPLCTONC.fTargetVelocity<>0)THEN
					stAxis.stPLCTONC.fTargetVelocity:=_pNextRoadmover^.stPLCTONC.fTargetVelocity;
				END_IF
			END_IF*)  //06.30 
		ELSE
			RETURN ;
		END_IF
	END_IF
END_IF
// 06.18 增加前后动子重新触发指令时速度限制
IF (_pPremover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid  THEN
   IF (stAxis.stAxisStatus.nNcCycleCounter<>0)  THEN    //01.15
		IF _pPremover^.stAxisStatus.nNcCycleCounter<>0 AND (stAxis.stAxisStatus.stPathRef.fTargetVelocity=_pPremover^.stAxisStatus.stPathRef.fTargetVelocity) THEN
			IF  stAxis.stPLCTONC.fDealtGap<>0 THEN 
				IF _fSetVelo>stAxis.stAxisStatus.stPathRef.fTargetVelocity AND (_fRealDis<=(_fGapSet+stAxis.stPLCTONC.fDealtGap)) THEN
					stAxis.stPLCTONC.fTargetVelocity:=stAxis.stAxisStatus.stPathRef.fTargetVelocity;
				END_IF
			ELSE
				IF _fSetVelo>stAxis.stAxisStatus.stPathRef.fTargetVelocity AND (_fRealDis<=(_fGapSet+fDealtGap)) THEN
					stAxis.stPLCTONC.fTargetVelocity:=stAxis.stAxisStatus.stPathRef.fTargetVelocity;
				END_IF
			END_IF
		END_IF
   END_IF 
ELSE
	IF (stAxis.stAxisStatus.nNcCycleCounter<>0)   THEN    //01.15
		IF _pNextRoadmover^.stAxisStatus.nNcCycleCounter<>0 AND (stAxis.stAxisStatus.stPathRef.fTargetVelocity=_pNextRoadmover^.stAxisStatus.stPathRef.fTargetVelocity) THEN
			IF  stAxis.stPLCTONC.fDealtGap<>0 THEN 
				IF _fSetVelo>stAxis.stAxisStatus.stPathRef.fTargetVelocity AND (_fRealDis<=(_fGapSet+fDealtGap)) THEN
					stAxis.stPLCTONC.fTargetVelocity:=stAxis.stAxisStatus.stPathRef.fTargetVelocity;
				END_IF
			 ELSE
				 IF _fSetVelo>stAxis.stAxisStatus.stPathRef.fTargetVelocity AND (_fRealDis<=(_fGapSet+fDealtGap)) THEN
					stAxis.stPLCTONC.fTargetVelocity:=stAxis.stAxisStatus.stPathRef.fTargetVelocity;
				 END_IF
			 END_IF
		END_IF
   END_IF 
END_IF

IF NOT bCollsionNotValid THEN 
	IF (stAxis.stPLCTONC.stEndPosition.fPosition<>fPosition) THEN 
		_bTargetDiff:=TRUE;
	ELSE
		_bTargetDiff:=FALSE;
	END_IF 
END_IF 


(****************** path time calculate*******************)
IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	stAxis.stAxisStatus.bPositiveDirection:=TRUE;
	stAxis.stAxisStatus.bNegativeDirection:=FALSE;
ELSE
    stAxis.stAxisStatus.bPositiveDirection:=FALSE;
	stAxis.stAxisStatus.bNegativeDirection:=TRUE;
END_IF

_bPreGeneSegDone:=TRUE;
_fLastGap:=fGap;      //12.26

]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_PathUpdateCheck" Id="{a520c903-9fb4-4c80-ba2e-0f5d8aac84e5}">
      <Implementation>
        <ST><![CDATA[IF (_pPremover^.stNcTOPLC.nAxisId<>0)THEN
	IF(_pPremover^.stAxisStatus.nNcCycleCounter=0)THEN  //静止
		IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
			_fDyPathDis1:= _pPremover^.stNcTOPLC.fActPos-stAxis.stPLCTONC.stEndPosition.fPosition-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
			IF _bIsGroupMember THEN  //03.31 
