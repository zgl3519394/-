<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FTS_MCMoveAbsolute" Id="{b861e511-8910-4197-93d6-7c5092836b6f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FTS_MCMoveAbsolute
VAR_IN_OUT
	stAxis: ST_Axis;
END_VAR
VAR_INPUT
	bExecute: BOOL;
	bContinuousUpdate: BOOL;
	bCollsionNotValid: BOOL := FALSE;
	fPosition: LREAL;
	fVelocity: LREAL;
	fAcceleration: LREAL;
	fDeceleration: LREAL;
	fJerk: LREAL;
	fGap: LREAL;
	///eDirection              : E_Direction:=1;
	eBufferMode: E_MCBufferMode := E_MCBufferMode.ABORTING;
END_VAR
VAR_OUTPUT
	bDone: BOOL;
	bBusy: BOOL;
	bActive: BOOL;
	bCommandAborted: BOOL;
	bError: BOOL;
	nErrorId: UDINT;
END_VAR
VAR
	_bCollisionChecked: BOOL;
	_bCounterTriger: BOOL := FALSE;
	_bPathSafe: BOOL := FALSE;
	_bSameCycle: BOOL := FALSE;
	_bPathCalDone: BOOL := FALSE;
	/// _bSameVelo         :BOOL:=FALSE;
	/// _bAutoFillIn       :BOOL:=FALSE;
	_bPathCalExecute: BOOL := FALSE;
	_bParamError: BOOL := FALSE;
	_bSegDone: BOOL;
	_bNcStart: BOOL;
	_bTargetDiff: BOOL;
	_bSegOver: BOOL := FALSE;
	_bPreGeneSegDone: BOOL := FALSE;
	_bNegPosStop: BOOL := FALSE;
	///_bStartTime    :BOOL;
	_bDyPathUpdate: BOOL := FALSE;
	_bDyPathCalOk: BOOL := FALSE;
	///03.31
	_bIsGroupMember: BOOL := FALSE;
	_bIsCollisionCheck: BOOL := FALSE;   //01.29
	//_bCollsionNotValid: BOOL := FALSE;
	_eCommand: E_Command;
	/// _nCollState        :WORD;
	_nStep: INT;
	_nSysType: UINT;
	_nPointNum: UDINT;
	_nPrePointNum: UDINT;
	_nCycleCount: UDINT := 0;
	_nSyncCounter: UDINT := 0;
	///02.24
	_nLastNcCycleCounter: UDINT;
	///02.24
	_nDealtNcCycleCounter: UDINT;
	///02.24
	_nLastCycleCounter: UDINT;
	///02.24
	_nDealtCycleCounter: UDINT;
	/// _nErrorId        : UDINT;
	_fPrePosition: LREAL;
	_fPrePositionTemp: LREAL;
	_fPrePositionTemp1: LREAL;
	_fPostion: LREAL;
	_fTotalTime: LREAL;
	_fPreCurTime: LREAL;
	_fCurrentTime: LREAL;
	_fStartTime: LREAL;
	_fStartVelocity: LREAL;
	_fStartPosition: LREAL;
	_fLastVelocity: LREAL;
	///_nCounter    :INT;
	///_fPostion    :LREAL;
	_fDistance: LREAL;
	_fStartPos: LREAL;
	_fDelat_Pos: LREAL;
	_fDelat_StartPos: LREAL;
	_fSetVelo: LREAL;
	_fSetPos: LREAL;
	_fExpVelo: LREAL;
	///_fPosMin: LREAL;
	_fClampLength: LREAL;
	_fGap: LREAL;
	/// 成组组内gap 03.31
	_fGroupInGap: LREAL;
	_fSafePos: LREAL;
	_fDyPathDis1: LREAL;
	_fDyPathDis2: LREAL;
	_fAcc: LREAL;
	_fDec: LREAL;
	_fRealDis: LREAL;
	_fPhyRealDis :lreal;
	_fGapSet: LREAL;
	_fLastParam_Pos: LREAL;
	_fLastParam_Vel: LREAL;
	_fLastGap: LREAL;
	///09.11
	_fSafeDis: LREAL;
	_fAbortedSafeDis: LREAL;
	_fPreDecDis: LREAL;
	_fNewDec: LREAL;
	_fPosMin: LREAL;
	_fUpDis: LREAL;
	_fUpPreTaLeft: LREAL;
	_fUpTa: LREAL;
	_fUpTv: LREAL;
	_fUpTd: LREAL;
	_fPreTime: LREAL;
	_fVmax: LREAL;
	_fVend: LREAL;
	_fPreDis: LREAL;
	_fPreVMax: LREAL;
	_fCuDis: LREAL;
	///10.30
	_fLastEndPos: LREAL;
	_stTimeInfo: ST_TimeRef;
	_sMessage3: STRING;
	_sMessage: STRING(1024);
	_eDirection: E_Direction;
	_eGroupType: E_GroupType;
	_eTrackType: E_TrackType;
	_pPremover: POINTER TO ST_Axis;
	_stAxisNo: ST_Axis;
	_stPrePathRef: ST_PathRef;
	_stPathPointTemp: ST_Point;
	_stPathNoPoint: ST_Point;
	_stPathRef: ST_PathRef;
	_stNoPathRef: ST_PathRef;
	_stLastCmdExeParam: ST_MCExecuteParam;
	_aNoPath: ARRAY[0..2] OF ST_PathSegment;
	_fbTrig: R_TRIG;
	_fbReTrig: R_TRIG;
	_fbPosTrig: R_TRIG;
	///03.04
	_fbEnbleTrig: F_TRIG;
	///03.04
	_fbPreMoveErrTrig: R_TRIG;
	_fbDyTrig: R_TRIG;
	_fbSynMotion: R_TRIG;
	_fbTon: TON;
	_fbDoneTon: TON;
	_fbWaitTon: TON;
	///03.04
	_fCommandAbortedTon: ton;
	///03.04
	_fErrorTon: ton;
	_fbTraPlanning: FB_TrajectoryPlanning;
END_VAR
VAR CONSTANT
	//fNcCycle: REAL := 0.002;
	fPosMin: REAL := 1000;
	///按最大速度计算
	fDealtGap: REAL := 10000;
	fPreSetDis: REAL := 100000;
	tcDoneTime: TIME := TIME#100ms;
	tcWaitTime: TIME := TIME#50ms;
	tcCalcuTime: TIME := TIME#33m20s0ms;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// 前置、后置配置
IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	IF (stAxis.stAxisStatus.pPremover=null)THEN 
		_pPremover:=ADR(_stAxisNo);
	ELSE
		_pPremover:=stAxis.stAxisStatus.pPremover;
	END_IF
ELSE
	IF (stAxis.stAxisStatus.pAftermover=null)THEN 
		_pPremover:=ADR(_stAxisNo);
	ELSE
		_pPremover:=stAxis.stAxisStatus.pAftermover;
	END_IF
END_IF

//指令检测
A_CommandCheck();

//状态
(*IF _bCounterTriger THEN 
	_nCycleCount:=_nCycleCount+1;
END_IF*)
// 02.24增加task事件判断
IF (_nStep<>0)THEN 
	_nCycleCount:=_nCycleCount+1;
ELSE
	_nCycleCount:=0;
END_IF

_fCurrentTime:=UDINT_TO_LREAL(stAxis.stAxisStatus.nNcCycleCounter)*GVL_MC.rNcCycle;  

IF (_pPremover^.stNcTOPLC.nAxisId<>0)THEN 
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		_fRealDis:=_pPremover^.stNcTOPLC.fActPos-stAxis.stNcTOPLC.fActPos;
		IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
			_fRealDis:=_pPremover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stNcTOPLC.fActPos;
		END_IF
		
	ELSE
		_fRealDis:=stAxis.stNcTOPLC.fActPos-_pPremover^.stNcTOPLC.fActPos;
		IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
			_fRealDis:=stAxis.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stNcTOPLC.fActPos;
		END_IF
	END_IF
	_fPhyRealDis:=ABS(_pPremover^.stCodToNCParam.fActualPos-stAxis.stCodToNCParam.fActualPos);  //05.18 		
END_IF


// 流程控制
CASE _nStep  OF 
	0:
	  
	   IF NOT bExecute THEN 
		   bError:=FALSE;
		   bCommandAborted:=FALSE;
		   bDone:=FALSE;
		   nErrorId:=0;
		   //_bCounterTriger:=FALSE;
		   _fLastParam_Pos:=0;
           _fLastParam_Vel:=0;
		   _fLastGap:=0;
		   _eCommand:=E_Command.COMMAND_IDLE;
	       IF (stAxis.stPLCTONC.eCommand=E_Command.COMMAND_IDLE)THEN  //06.20
			   IF stAxis.stPLCTONC.bNcStart THEN
				   stAxis.stPLCTONC.bNcStart:=FALSE;
			   END_IF
		   END_IF
	   END_IF
	 
	   RETURN;
	  
    5:   (***********initialization*******************)
	      
	     A_Init();
	     bBusy:=TRUE;
	     bError:=FALSE;
	     bCommandAborted:=FALSE;
		 bActive:=FALSE;
	     nErrorID:=0;
	     bDone:=FALSE;
		 A_ParamCheck();
		 //03.25 指令打断缓冲
		 IF (stAxis.stPLCTONC.eCommand<>E_Command.COMMAND_ABSOLUTE)THEN
			 IF NOT stAxis.stPLCTONC.bNcStart THEN
				 _nStep:= 10;
			 END_IF
		 ELSE
			 (*stAxis.stPLCTONC.bNcStart:=FALSE;
		     _nStep:= 10;*)  ///10.12 
			 
			 IF stAxis.stPLCTONC.bNcStart THEN 
				 stAxis.stPLCTONC.bNcStart:=FALSE;
			 ELSE
				 _nStep:= 10;
			 END_IF
			 
		 END_IF
		// stAxis.stPLCTONC.bNcStart:=FALSE;
		 //_nStep:= 10;
		 IF _bParamError  THEN 
			 _nStep:= 100;
			 _bParamError:=FALSE;
		 END_IF
		 
    10:  (*************Path generation****************)
	     bActive:=TRUE;
	     A_PathPreGeneration();
		 stAxis.stAxisStatus.bDiscreteMotion:=TRUE;
		 stAxis.stAxisStatus.bContinuousMotion:=FALSE;
		 stAxis.stAxisStatus.bSynchronizedMotion:=FALSE;
		 stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_ABSOLUTE;
		 _eCommand:=stAxis.stPLCTONC.eCommand;
		 
		// _bCollisionChecked:=FALSE;
		 IF _bPreGeneSegDone THEN 
				 stAxis.stPLCTONC.bNcEnable:=TRUE;
		         stAxis.stPLCTONC.bNcStart:=TRUE;
				 //stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_ABSOLUTE;
				// _eCommand:=stAxis.stPLCTONC.eCommand;
				 stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_TSHAPED;
	             stAxis.stAxisStatus.bMoving:=TRUE;
				 _bCollisionChecked:=FALSE;
			     _bPreGeneSegDone:=FALSE;
				 _bSegOver:=FALSE;
				 IF(_fLastVelocity>_fSetVelo)AND NOT bCollsionNotValid THEN 
					 stAxis.stPLCTONC.bCmdDceUpdate:=TRUE;
				 END_IF
				 _nStep:= _nStep+10;
	             stAxis.stPLCTONC.bEndPosCalDone:=TRUE;    //04.02
				 IF stAxis.stPLCTONC.nRoadID_1<>0 AND stAxis.stPLCTONC.nRoadID_2<>0 THEN    //08.20 
					 stAxis.stPLCTONC.nRoadID_1:=0;
	                 stAxis.stPLCTONC.nRoadID_2:=0; 
				 END_IF
				 IF GVL_MC.cDebug  THEN   //04.17
					_sMessage:=FC_StrContact(stAxis,'abs generate path');
					 ADSLOGSTR(ADSLOG_MSGTYPE_HINT, _sMessage, '');
				 END_IF
		 END_IF
		 IF _bSegOver THEN      //防碰撞停止
			_bCollisionChecked:=TRUE;
		 END_IF
		 IF _bSegDone THEN     //当前位置和目标位置一致
			_nStep:=40;
			bBusy:=FALSE;
			bActive:=FALSE;
			bDone:=TRUE;
			_bSegDone:=FALSE;
			stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
			_bCollisionChecked:=FALSE;
			stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
			_eCommand:=E_Command.COMMAND_IDLE;
			RETURN;
		END_IF
		
		IF _bNegPosStop THEN 
			_nStep:= 50;
			_bNegPosStop:=FALSE;
			
		END_IF
		IF _bIsCollisionCheck THEN   //碰撞检测 10.30
			_nStep:= 30;
			_bIsCollisionCheck:=FALSE;
		END_IF
		IF _bParamError  THEN 
			 _nStep:= 100;
			 _bParamError:=FALSE;
		END_IF
		
	20:
		 _nStep:= 30;
		
		 _nDealtCycleCounter:=_nCycleCount-_nLastCycleCounter;
		 _nDealtNcCycleCounter:=stAxis.stAxisStatus.nNcCycleCounter_WP-_nLastNcCycleCounter;
		 IF (_nDealtCycleCounter< _nDealtNcCycleCounter)THEN
			  stAxis.stPLCTONC.bNcStart:=FALSE;     //12.27
		 END_IF
		 stAxis.stPLCTONC.bEndPosCalDone:=FALSE;    //04.02
	30: 
	    
	    stAxis.stPLCTONC.bNcStart:=FALSE;
		stAxis.stPLCTONC.bCmdDceUpdate:=FALSE;
	
	    IF (stAxis.stNcTOPLC.nAxisState=2)AND (stAxis.stAxisStatus.nNcCycleCounter=0)  THEN   
			
			IF (ABS(LTRUNC(stAxis.stNcTOPLC.fActPos)- LTRUNC(fPosition))>1) THEN  //03.05
				_bTargetDiff:=TRUE;
			END_IF
			IF _bTargetDiff   THEN        // target position have mover 
			    _nStep:=10;
				stAxis.stPLCTONC.bNcStart:=FALSE;
			    stAxis.stPLCTONC.bNcEnable:=FALSE;
				
			ELSE 
				bDone:=TRUE;
				bBusy:=FALSE;
	            bError:=FALSE;
	            bCommandAborted:=FALSE;
	            nErrorID:=0;
			    bActive:=FALSE;
			    stAxis.stPLCTONC.bNcStart:=FALSE;
			    stAxis.stPLCTONC.bNcEnable:=FALSE;
				
				IF bExecute THEN 
					_nStep:= 0;
				//	_bCounterTriger:=FALSE;
		            _nCycleCount:=0;
		            stAxis.stAxisStatus.bMoving:=FALSE;
					stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		            stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
					
		            stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
					_bCollisionChecked:=FALSE;
				ELSE
					_nStep:= _nStep+10;
				END_IF
			END_IF
			(*IF stAxis.stAxisStatus.bEmStopping THEN  //02.28
				_nStep:= 100;
			    nErrorID:=29682;
			    //_nStep:= 40;
				stAxis.stAxisStatus.bEmStopping:=FALSE;
			END_IF*)  // 05.18
		END_IF
        // 路径动态更新
		IF NOT bCollsionNotValid AND (stAxis.stNcTOPLC.nAxisState<>2)THEN
			A_PathUpdateCheck();
			IF (_pPremover^.stNcTOPLC.nAxisId=0)THEN
				_fDyPathDis1:=20;
				_fSafeDis:=10; //10.28
			END_IF
          //  _fbDyTrig(CLK:=(_fDyPathDis1>10)AND(_fStartTime<=0.02)AND(stAxis.stPLCTONC.stEndPosition.fPosition<>_fSetPos) , Q=> );  //09.10
		  _fbDyTrig(CLK:=(_fDyPathDis1>10)AND(_fStartTime<=0.02)AND(stAxis.stPLCTONC.stEndPosition.fPosition<>_fSetPos)AND (_fSafeDis>0) , Q=> ); 
			IF _fbDyTrig.Q THEN 
					_nStep:=10;
					_fbDyTrig(CLK:=FALSE , Q=> );
					IF GVL_MC.cDebug  THEN   //04.17
					   _sMessage3:=CONCAT(DWORD_TO_STRING(stAxis.stNcTOPLC.nAxisId),'abs dy PathUpdate');
					   ADSLOGSTR(ADSLOG_MSGTYPE_HINT, _sMessage3, 'abs dy PathUpdate');
					END_IF
					
			END_IF
			
		END_IF 
		
		
	40:
       //_fbDoneTon(IN:=TRUE, PT:=tcDoneTime , Q=> , ET=> );
       //IF _fbDoneTon.Q THEN
		 bDone:=FALSE;
		 _fbDoneTon(IN:=FALSE, PT:=tcDoneTime , Q=> , ET=> );
		 _nStep:=0;
		// _bCounterTriger:=FALSE;
		 _nCycleCount:=0;
		 _fLastParam_Pos:=0;
         _fLastParam_Vel:=0;
		 _fLastGap:=0;
		  stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		  stAxis.stAxisStatus.bMoving:=FALSE;
		  stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
		  _eCommand:=E_Command.COMMAND_IDLE;
		  stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
		  _bCollisionChecked:=FALSE;
	 //  END_IF	

    // 01/10 新增更新位置计算小于当前位置停止处理
    50:   
	     A_StopPathGerenation();
		 stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_ABSOLUTE;
		 _eCommand:=stAxis.stPLCTONC.eCommand;
		 stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_TSHAPED;
	     stAxis.stPLCTONC.bNcStart:=TRUE;
		 stAxis.stAxisStatus.bStoppingFlag:=TRUE;     
	     _nStep:=_nStep+10;
    60:
	     IF (stAxis.stNcTOPLC.nAxisState=2)THEN
	        _nStep:=10; 
		    stAxis.stPLCTONC.bNcStart:=FALSE;
		    stAxis.stAxisStatus.bStoppingFlag:=FALSE;  
	     END_IF 
	//   01/10 新增更新位置计算小于当前位置停止处理
    
    70:   //去使能

		IF (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN   //08.08
			A_StopPathGerenation();
	        stAxis.stPLCTONC.bNcStart:=TRUE;
			stAxis.stAxisStatus.bStoppingFlag:=TRUE;   //03.04
	        _nStep:=_nStep+10;   
		ELSE     //补位状态
			
			  _nStep:=90;   
		END_IF
    80:
	
	    IF (stAxis.stNcTOPLC.nAxisState=2)THEN
	       _nStep:=90; 
		   stAxis.stPLCTONC.bNcStart:=FALSE;
	
		   stAxis.stAxisStatus.bStoppingFlag:=FALSE;    //03.04
		   
	     END_IF 
		
	90:
	   
		     bCommandAborted:=TRUE;
			 bBusy:=FALSE;
	         bActive:=FALSE;
			 bDone:=FALSE;
			 _fbDoneTon(IN:=FALSE, PT:=tcDoneTime , Q=> , ET=> );
			  _nStep:=0;
			 _nCycleCount:=0;
			 _stPathRef.bCalculateDone:=FALSE;
			 _bPathCalDone:=FALSE;
			 _bTargetDiff:=FALSE;
			 _fLastParam_Pos:=0;
             _fLastParam_Vel:=0;
			 _fLastGap:=0;
			 _bCollisionChecked:=FALSE;
			  stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
			  stAxis.stAxisStatus.bMoving:=FALSE;
			  stAxis.stPLCTONC.bNcEnable:=FALSE;
			  stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
			  stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
			  _eCommand:=E_Command.COMMAND_IDLE;
			  stAxis.stPLCTONC.bEndPosCalDone:=FALSE;    //04.02
	          _bIsCollisionCheck:=FALSE;   //10.31
			  stAxis.stAxisStatus.bEmStopping:=FALSE;
	
    100: (************error handle***********)
        bBusy:=FALSE;
	    bError:=TRUE;
	    bActive:=FALSE;
	    bDone:=FALSE;
	    bCommandAborted:=FALSE;
	    stAxis.stAxisStatus.bError:=TRUE;
		stAxis.stAxisStatus.nErrorId:=nErrorID;
	    stAxis.stAxisStatus.bMoving:=FALSE;
	    _bNcStart:=FALSE;
		stAxis.stPLCTONC.bNcStart:=FALSE;
		stAxis.stPLCTONC.bNcEnable:=FALSE;
		stAxis.stPLCTONC.eCommand:=E_Command.COMMAND_IDLE;
		
		stAxis.stPLCTONC.ePlanningMode:=E_PlanningMode.PLANNINGMODE_NONE;
		stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
	    _nStep:=0;
		_fLastParam_Pos:=0;
        _fLastParam_Vel:=0;
		_fLastGap:=0;
        _bCollisionChecked:=FALSE;
		stAxis.stAxisStatus.bStoppingFlag:=FALSE;
		_nCycleCount:=0;
		stAxis.stPLCTONC.bEndPosCalDone:=FALSE;    //04.02
		_bIsCollisionCheck:=FALSE;   //10.31
		(************command aborted***********)  //03.04
    110:
	    bCommandAborted:=TRUE;
		bBusy:=FALSE;
		bDone:=FALSE;
		bActive:=FALSE;
		_nStep:=0; 
		_stPathRef.aExecutablePath:=_aNoPath;
		_bSegOver:=FALSE;
		_nCycleCount:=0;
		stAxis.stAxisStatus.bMoving:=FALSE;
		_bTargetDiff:=FALSE;
		_fLastParam_Pos:=0;
		_fLastParam_Vel:=0;
		_fLastGap:=0;
		//stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
		_bCollisionChecked:=FALSE;
	    stAxis.stPLCTONC.bEndPosCalDone:=FALSE;    //04.02
		_bIsCollisionCheck:=FALSE;   //10.31
END_CASE

A_UpstateStatus();


]]></ST>
    </Implementation>
    <Action Name="A_AbortedCollisionCheck" Id="{10e7f291-4b29-40b8-a3ac-0c524a80d17c}">
      <Implementation>
        <ST><![CDATA[// 计算新指令碰撞检测
IF (_pPremover^.stNcTOPLC.nAxisId<>0) AND (_pPremover^.stAxisStatus.nNcCycleCounter>0) THEN
	   _fPreDecDis:= stAxis.stPLCTONC.fTargetVelocity* stAxis.stPLCTONC.fTargetVelocity/_fDec;
	   _stTimeInfo:= _fbTraPlanning.M_TShaped(
					fVeloStart:=stAxis.stNcTOPLC.fActVelo , 
					fVeloEnd:=0 , 
					fTargetVelo:=stAxis.stPLCTONC.fTargetVelocity , 
					fDistance:=_fDistance , 
					fAccleration:= _fAcc, 
					fDeceleration:=_fDec );
					
	   //分类讨论  只考虑前动子在加速段情况，减速段和匀速段不考虑
	   // 后动子 分为加速段 匀速段 和减速段三种情况
	   // 后动子在加速段
	   _fPreTime:=UDINT_TO_LREAL(_pPremover^.stAxisStatus.nNcCycleCounter)*GVL_MC.rNcCycle;
	   
	   IF _fPreTime<_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fTa 
             AND  _pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fStartVelo<_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fExpVelo THEN   // 前动作子加速段
		   IF _fCurrentTime<stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTa THEN //后动子加速段 分为两种情况
			   IF _pPremover^.stNcTOPLC.fActVelo< stAxis.stNcTOPLC.fActVelo THEN
				  _fUpPreTaLeft:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fTa-_fPreTime;
			      _fPreVMax:=_fUpPreTaLeft*_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fAccleration+_pPremover^.stNcTOPLC.fActVelo;
			      _fPreDis:=0.5*(_pPremover^.stNcTOPLC.fActVelo+_fPreVMax)*_fUpPreTaLeft;
			      _fVmax:=stAxis.stNcTOPLC.fActVelo+_stTimeInfo.fTa*_fAcc;
				  
			      IF _fUpPreTaLeft<= _stTimeInfo.fTa THEN 
					   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_fUpPreTaLeft;
				  ELSIF _fUpPreTaLeft<=(_stTimeInfo.fTa+_stTimeInfo.fTv) THEN
					  
					   _fUpTv:=_fUpPreTaLeft-_stTimeInfo.fTa;
					   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_stTimeInfo.fTa+_fVmax*_fUpTv;
				  ELSE
					   _fUpTd:=_fUpPreTaLeft-_stTimeInfo.fTv-_stTimeInfo.fTa;
					   _fVend:=_fVmax-_fUpTd*_fDec;
					   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_stTimeInfo.fTa+_fVmax*_stTimeInfo.fTv+0.5*(_fVend+_fVmax)*_fUpTd;
				  END_IF
				   _fAbortedSafeDis:=_fRealDis-_fGap-_fClampLength+_fPreDis-_fCuDis;
					  
				ELSE   // 前动子速度大于后动子实际速度 直接更新
					   _fAbortedSafeDis:=10;
				END_IF
		   ELSIF _fCurrentTime<=(stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTa+stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTv) THEN  //匀速段
			   _fAbortedSafeDis:=_fRealDis-_fGap-_fClampLength-_fPreDecDis;
		   
		   ELSE   //减速段
			   _fUpPreTaLeft:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fTa-_fPreTime;
			   _fPreVMax:=_fUpPreTaLeft*_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fAccleration+_pPremover^.stNcTOPLC.fActVelo;
			   _fPreDis:=0.5*(_pPremover^.stNcTOPLC.fActVelo+_fPreVMax)*_fUpPreTaLeft;
			   _fVmax:=stAxis.stNcTOPLC.fActVelo+_stTimeInfo.fTa*_fAcc;
               IF _fUpPreTaLeft<= _stTimeInfo.fTa THEN 
				   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_fUpPreTaLeft;
               ELSIF _fUpPreTaLeft<=(_stTimeInfo.fTa+_stTimeInfo.fTv) THEN
                  
				   _fUpTv:=_fUpPreTaLeft-_stTimeInfo.fTa;
                   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_stTimeInfo.fTa+_fVmax*_fUpTv;
			   ELSE
				   _fUpTd:=_fUpPreTaLeft-_stTimeInfo.fTv-_stTimeInfo.fTa;
				   _fVend:=_fVmax-_fUpTd*_fDec;
				   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_stTimeInfo.fTa+_fVmax*_stTimeInfo.fTv+0.5*(_fVend+_fVmax)*_fUpTd;
			   END_IF
			   _fAbortedSafeDis:=_fRealDis-_fGap-_fClampLength+_fPreDis-_fCuDis;
			   
		   END_IF
		   IF _fAbortedSafeDis>0 THEN 
			    _bIsCollisionCheck:=FALSE;
		   END_IF
	   ELSE
		    _bIsCollisionCheck:=FALSE;
	   END_IF
ELSE
	_bIsCollisionCheck:=FALSE;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_CommandCheck" Id="{407ed5ca-3000-446e-a709-c46d0fcbe59a}">
      <Implementation>
        <ST><![CDATA[//注意优先级，最下面优先级最高

_fbTrig(CLK:=bExecute , Q=> );
IF _fbTrig.Q  THEN
	IF (NOT stAxis.stAxisStatus.bEnabled) OR stAxis.stAxisStatus.bError OR stAxis.stAxisStatus.bStopping THEN 
		_nStep:=100;
		//bError:=TRUE;
		nErrorID:=29673;
		RETURN;
	END_IF 
	
	    _stLastCmdExeParam.eCommand:=stAxis.stPLCTONC.eCommand;
		_stLastCmdExeParam.ePlanningMode:=stAxis.stPLCTONC.ePlanningMode;
		_stLastCmdExeParam.fTargetVelocity:=stAxis.stPLCTONC.fTargetVelocity;
		_stLastCmdExeParam.stStartPosition:=stAxis.stPLCTONC.stStartPosition;
		_stLastCmdExeParam.stEndPosition:=stAxis.stPLCTONC.stEndPosition;
		_nStep:=5;
		IF (stAxis.stAxisStatus.nNcCycleCounter>0)AND(_eCommand=E_Command.COMMAND_ABSOLUTE) THEN    //10.30增加指令判断条件
			_bIsCollisionCheck:=TRUE;
			_fLastEndPos:=stAxis.stPLCTONC.stEndPosition.fPosition;
		END_IF
	   
	    _nCycleCount:=0;
END_IF

//command aborted  

IF (stAxis.stPLCTONC.eCommand<>E_Command.COMMAND_ABSOLUTE) AND (_nStep<>0)AND(_eCommand=E_Command.COMMAND_ABSOLUTE)THEN 
	_nStep:=110;
END_IF

// 前动子异常
_fbPreMoveErrTrig(CLK:=_pPremover^.stAxisStatus.bError AND (_fRealDis<=(_fGap+0.5*_pPremover^.stAxisParam.fClampLength))   , Q=> );
IF _fbPreMoveErrTrig.Q THEN 
	IF (_nStep=0) THEN  
			bBusy:=FALSE;
			bDone:=FALSE;
			bActive:=FALSE;
			_nStep:=0; 
			_stPathRef.aExecutablePath:=_aNoPath;
			//_bCounterTriger:=FALSE;
			_nCycleCount:=0;
			stAxis.stAxisStatus.bMoving:=FALSE;
			_bTargetDiff:=FALSE;
			_fLastParam_Pos:=0;
            _fLastParam_Vel:=0;
			_fLastGap:=0;
			stAxis.stAxisStatus.bDiscreteMotion:=FALSE;
			_bCollisionChecked:=FALSE;
	ELSE
		_nStep:=70;
	END_IF
	 
END_IF


//disEnable  去使能状态清除 不做规划
_fbEnbleTrig(CLK:=stAxis.stAxisStatus.bEnabled , Q=> );
IF _fbEnbleTrig.Q THEN 
	IF (_nStep=0) THEN 
			bBusy:=FALSE;
			bDone:=FALSE;
			bActive:=FALSE;
			_stPathRef.aExecutablePath:=_aNoPath;
			
			_nCycleCount:=0;
		
			_bTargetDiff:=FALSE;
			_fLastParam_Pos:=0;
            _fLastParam_Vel:=0;
			_fLastGap:=0;
			
			_bCollisionChecked:=FALSE;
			_bIsCollisionCheck:=FALSE;   //10.31
			stAxis.stAxisStatus.bEmStopping:=FALSE;
	ELSE
		//_nStep:=70;
		_nStep:=90;
	END_IF
	 
END_IF









]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_Init" Id="{e67fab58-5f21-478c-9d87-189c05820f08}">
      <Implementation>
        <ST><![CDATA[_nCycleCount:=0;
//_bStartSametime:=FALSE;
_bSegOver:=FALSE;
_bPreGeneSegDone:=FALSE;
//_bSameVelo:=FALSE;
//_bPathSafe:=FALSE; 
_bCollisionChecked:=FALSE;
_bPathCalDone:=FALSE;
//_stPathRef.bCalculateDone:=FALSE;
_fDistance:=0;
_fPrePosition:=0;
//_bAutoFillIn :=FALSE;

//_bDyPathCalOk:=FALSE;
//_bDyPathUpdate:=FALSE;

 _bPreGeneSegDone:=false;

_fDyPathDis1:=0;
_fDyPathDis2:=0;
(**********路径清除**************)

 //_stPathRef.aExecutablePath:=_aNoPath;
//_stPathRef.aSafePath:=_aNoPath;
//_stPathRef.aPreplannedPath:=_aNoPath;

//_stPathRef:=_stNoPathRef;
//_stPrePathRef:=_stNoPathRef;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_MeasureIn" Id="{dec1d5ca-d944-4e82-97ae-b2dbae28e2b7}">
      <Implementation>
        <ST><![CDATA[
IF ABS(fVelocity)>stAxis.stAxisParam.stDynamicDefault.fMaxVelocity THEN 
	_fSetVelo:= stAxis.stAxisParam.stDynamicDefault.fMaxVelocity ;
ELSE
	_fSetVelo:= ABS(fVelocity) ;
END_IF


_fSetPos:= fPosition ;

_fClampLength:=ABS(stAxis.stAxisParam.fClampLength*0.5);
IF (fGap<>0)THEN 
   _fGap :=_fClampLength+ABS(fGap);
     
ELSE
  _fGap :=_fClampLength+ABS(stAxis.stAxisParam.fGap);
  bCollsionNotValid:=TRUE;
END_IF

IF (fAcceleration=0) THEN 
	_fAcc:=stAxis.stAxisParam.stDynamicDefault.fDefaultAccelaration;
ELSE
	_fAcc:=ABS(fAcceleration);
	IF (fAcceleration>stAxis.stAxisParam.stDynamicDefault.fMaxAccelaration)THEN
		_fAcc:=stAxis.stAxisParam.stDynamicDefault.fMaxAccelaration;
	END_IF
END_IF


IF (fDeceleration=0) THEN
   _fDec:=stAxis.stAxisParam.stDynamicDefault.fDefaultDeceleration;
ELSE 
	_fDec:=ABS(fDeceleration);
	IF (fDeceleration>stAxis.stAxisParam.stDynamicDefault.fMaxDeceleration)THEN
		_fDec:=stAxis.stAxisParam.stDynamicDefault.fMaxDeceleration;
	END_IF
END_IF

(*IF (_fAcc<>_fDec)THEN
	_fDec:=_fAcc;
END_IF*)

IF (_fAcc<>_fDec) AND  NOT GVL_MC.bDebugDecAcc  THEN   //01.22
	_fDec:=_fAcc;
END_IF

_nSysType:=stAxis.stAxisParam.stRoadParam.nSysType;
//_eTrackType:=_nSysType;

//增加方向判断
IF (fPosition>=stAxis.stNcTOPLC.fActPos)THEN 
	_eDirection:=E_Direction.DIRECTION_POSITIVE;
ELSE
	_eDirection:=E_Direction.DIRECTION_NEGATIVE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_ParamCheck" Id="{ea29caf8-25cc-468e-b78a-1426a9048e44}">
      <Implementation>
        <ST><![CDATA[A_MeasureIn();

(*IF (eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	IF (fPosition<stAxis.stNcTOPLC.fActPos)THEN
		 _bParamError:=TRUE;
		 nErrorID:=29678;
		 RETURN;
	END_IF
ELSE
	IF (fPosition>stAxis.stNcTOPLC.fActPos)THEN
		 _bParamError:=TRUE;
		  nErrorID:=29679;
		 RETURN;
	END_IF
END_IF*)
IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	//IF (fPosition<stAxis.stNcTOPLC.fActPos)THEN  //04.29
	IF (fPosition<(stAxis.stNcTOPLC.fActPos-1))THEN  //04.29
		 _bParamError:=TRUE;
		 nErrorID:=29678;
		 RETURN;
	END_IF
ELSE
	//IF (fPosition>stAxis.stNcTOPLC.fActPos)THEN   //04.29
	IF (fPosition>(stAxis.stNcTOPLC.fActPos+1))THEN   //04.29 计算误差
		 _bParamError:=TRUE;
		  nErrorID:=29679;
		 RETURN;
	END_IF
END_IF

IF (fPosition<>0) AND (fVelocity=0) THEN       // param error 
	 _bParamError:=TRUE;
	 nErrorID:=29680;
	 RETURN;
END_IF

///04.20  增加roaid 判断
IF (_pPremover^.stNcTOPLC.nAxisId<>0)  THEN
	IF stAxis.stNcTOPLC.nCuRoadID<>_pPremover^.stNcTOPLC.nCuRoadID THEN 
		 _bParamError:=TRUE;
	      nErrorID:=29682;
	     RETURN;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_PathPreGeneration" Id="{f7bd541f-7591-41bd-93ec-bc5ceb72929f}">
      <Implementation>
        <ST><![CDATA[ 

_fLastParam_Pos:=fPosition;
_fLastParam_Vel:=fVelocity;

_fLastVelocity:=stAxis.stAxisStatus.stPathRef.fTargetVelocity;

stAxis.stPLCTONC.stStartPosition.fPosition:=stAxis.stNcTOPLC.fActPos;
stAxis.stPLCTONC.stStartPosition.fVelocity:=stAxis.stNcTOPLC.fActVelo;
stAxis.stPLCTONC.stStartPosition.fAccleration:=_fAcc;
stAxis.stPLCTONC.stStartPosition.fDeceleration:=_fDec;
stAxis.stPLCTONC.stStartPosition.fbJerk:=fJerk;
stAxis.stPLCTONC.stStartPosition.nRoadID:=stAxis.stNcTOPLC.nCuRoadID;   //02.20


stAxis.stPLCTONC.fTargetVelocity:=_fSetVelo;
stAxis.stPLCTONC.fSetVelocity:=_fSetVelo;  //04.25
stAxis.stPLCTONC.fTargetPos:=fPosition;   //03.20
stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
stAxis.stPLCTONC.stEndPosition.fAccleration:=_fAcc;
stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;
stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk;
stAxis.stPLCTONC.stEndPosition.nRoadID:=stAxis.stNcTOPLC.nCuRoadID;   //02.20

stAxis.stPLCTONC.nSysType:=_nSysType;
IF (_nSysType=1)OR (_nSysType=4) THEN 
	stAxis.stPLCTONC.nSysType:=2;
END_IF

stAxis.stAxisStatus.stPathRef.fGap:=_fClampLength;
stAxis.stAxisStatus.stPathRef.fSetGap:=_fGap;

// 是否成组判断，并根据条件计算组内gap距离  03.31
IF (_pPremover^.stNcTOPLC.nAxisId<>0)  THEN 
	IF (_pPremover^.stAxisStatus.stGroupRef.eGroupType<>E_GroupType.GROUPTYPE_NONE)
           AND (stAxis.stAxisStatus.stGroupRef.eGroupType<>E_GroupType.GROUPTYPE_NONE)THEN 
		IF (_pPremover^.stAxisStatus.stGroupRef.nGroupId=stAxis.stAxisStatus.stGroupRef.nGroupId)THEN
            IF NOT _bIsGroupMember THEN
			    _fGroupInGap:=LTRUNC(ABS(_pPremover^.stNcTOPLC.fActPos-stAxis.stNcTOPLC.fActPos));
			    
			END_IF
			//stAxis.stAxisStatus.stPathRef.fGroupInGap:=_fGroupInGap;
			stAxis.stPLCTONC.fGroupInGap:=_fGroupInGap;
			_bIsGroupMember:=TRUE;
		END_IF
	ELSE
		_bIsGroupMember:=FALSE;
	END_IF
ELSE
	_bIsGroupMember:=FALSE;
END_IF
// 判断如果成组，实际位置超过规划位置，按实际物理位置作为起点规划路径
IF _bIsGroupMember THEN 
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
        IF (stAxis.stNcTOPLC.fModuloSetPos<stAxis.stCodToNCParam.fActualPos)THEN 
			stAxis.stPLCTONC.stStartPosition.fPosition:=stAxis.stNcTOPLC.fActPos;
		END_IF
	ELSE
		IF (stAxis.stNcTOPLC.fModuloSetPos<stAxis.stCodToNCParam.fActualPos)THEN 
			stAxis.stPLCTONC.stStartPosition.fPosition:=stAxis.stNcTOPLC.fActPos;
		END_IF
    END_IF
END_IF


(******************save premover path ***************)
IF (_pPremover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid THEN
	
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN  //正向

		IF _pPremover^.stAxisStatus.bPositiveDirection THEN 
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aSafePath )-_fGap;
			IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle positive move
				_fPrePosition:=_fPrePosition+stAxis.stNcTOPLC.fModuloFactor;
			END_IF 
			IF _bIsGroupMember THEN   //03.31  重新计算组内可达位置
				_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath)-_fGroupInGap;
			END_IF
		ELSE
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath)-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
			IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle positive move
				_fPrePosition:=_fPrePosition+stAxis.stNcTOPLC.fModuloFactor;
			END_IF 
			
		END_IF
		_fPrePositionTemp:=_fPrePosition;
    ELSE   //负向
		
		IF _pPremover^.stAxisStatus.bNegativeDirection THEN // 负向
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aSafePath )+_fGap;
			IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle negative  move
				_fPrePosition:=_fPrePosition-stAxis.stNcTOPLC.fModuloFactor;
				 
			END_IF
			IF _bIsGroupMember THEN   //03.31  重新计算组内可达位置
				_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath)+_fGroupInGap;
			END_IF
		ELSE
			_fPrePosition:=FC_FindPosition(pPathData:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath )+_pPremover^.stAxisParam.fClampLength*0.5+_fGap;
			IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle negative  move
				_fPrePosition:=_fPrePosition-stAxis.stNcTOPLC.fModuloFactor;
				 
			END_IF
		END_IF
		_fPrePositionTemp:=_fPrePosition;
	END_IF
    
	IF (_pPremover^.stAxisStatus.nNcCycleCounter=0)THEN      //premover is not ready	
		IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
				_fPrePosition:=_pPremover^.stNcTOPLC.fActPos-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
				IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN 
				    _fPrePosition:=_pPremover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
                END_IF
				
				IF (_fPrePosition<=stAxis.stNcTOPLC.fActPos)AND(_fPrePosition<_fSetPos)THEN  //11/26
					_bSegOver:=TRUE;
					IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
							_bNegPosStop:=TRUE;
							_fLastGap:=fGap;
					END_IF
					RETURN;
				END_IF	
				
					(*IF NOT _bIsGroupMember THEN   //04.02 
						_bSegOver:=TRUE;
						IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
							_bNegPosStop:=TRUE;
							_fLastGap:=fGap;
						END_IF
						RETURN; 
					ELSE
						IF _pPremover^.stPLCTONC.bEndPosCalDone AND(stAxis.stAxisStatus.nNcCycleCounter=0)THEN 
							IF _fSetPos>(_pPremover^.stPLCTONC.stEndPosition.fPosition-_fGroupInGap) THEN 
								 _fPrePosition:=_pPremover^.stPLCTONC.stEndPosition.fPosition-_fGroupInGap;
							ELSE
								_fPrePosition:=_fSetPos;
							END_IF
						ELSE
	                        _bSegOver:=TRUE;
							IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
								_bNegPosStop:=TRUE;
								_fLastGap:=fGap;
							END_IF
							RETURN;
						END_IF
					END_IF*)
				//END_IF
				// 判断同时触发路径生成时，方向相反路径占用  11.06
				IF _pPremover^.stPLCTONC.bEndPosCalDone AND(stAxis.stAxisStatus.nNcCycleCounter=0)AND _pPremover^.stAxisStatus.bNegativeDirection THEN
					_fPrePosition:=_pPremover^.stPLCTONC.stEndPosition.fPosition-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
					IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN 
						_fPrePosition:=_pPremover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
					END_IF
					IF (_fPrePosition<=stAxis.stNcTOPLC.fActPos)AND(_fPrePosition<_fSetPos)THEN
						_bSegOver:=TRUE;
						RETURN;
					END_IF
				END_IF
				
		ELSE
				_fPrePosition:=_pPremover^.stNcTOPLC.fActPos+_pPremover^.stAxisParam.fClampLength*0.5+_fGap;
				IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN    //cycle negative  move 
					_fPrePosition:=_pPremover^.stNcTOPLC.fActPos-stAxis.stNcTOPLC.fModuloFactor+_pPremover^.stAxisParam.fClampLength*0.5+_fGap;
				END_IF
			    
				IF (_fPrePosition>=stAxis.stNcTOPLC.fActPos)AND (_fPrePosition>_fSetPos) THEN //11.26
					
                    //IF NOT  _bIsGroupMember THEN   //04.02 
						_bSegOver:=TRUE;
						IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
							_bNegPosStop:=TRUE;
							_fLastGap:=fGap;
						END_IF
						RETURN; 
				    //END_IF
				 END_IF
				 // 判断同时触发路径生成时，方向相反路径占用  11.06
				IF _pPremover^.stPLCTONC.bEndPosCalDone AND(stAxis.stAxisStatus.nNcCycleCounter=0)AND _pPremover^.stAxisStatus.bPositiveDirection THEN
					_fPrePosition:=_pPremover^.stPLCTONC.stEndPosition.fPosition+_pPremover^.stAxisParam.fClampLength*0.5+_fGap;
					IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN 
						_fPrePosition:=_pPremover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor+_pPremover^.stAxisParam.fClampLength*0.5+_fGap;
					END_IF
					IF (_fPrePosition>=stAxis.stNcTOPLC.fActPos)AND(_fPrePosition>_fSetPos)THEN
						_bSegOver:=TRUE;
						RETURN;
					END_IF
				 END_IF
				 
					(*ELSE
						IF _pPremover^.stPLCTONC.bEndPosCalDone AND(stAxis.stAxisStatus.nNcCycleCounter=0)THEN 
							IF _fSetPos<(_pPremover^.stPLCTONC.stEndPosition.fPosition+_fGroupInGap) THEN 
								 _fPrePosition:=_pPremover^.stPLCTONC.stEndPosition.fPosition+_fGroupInGap;
							ELSE
								_fPrePosition:=_fSetPos;
							END_IF
						ELSE
	                        _bSegOver:=TRUE;
							IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
								_bNegPosStop:=TRUE;
								_fLastGap:=fGap;
							END_IF
							RETURN;
						END_IF
					END_IF *)
					
				//END_IF
			    
		END_IF
	END_IF
	
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		IF (_fSetPos<=_fPrePosition)THEN
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fSetPos;
		ELSE
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fPrePosition;
		END_IF
	ELSE
		IF(_fSetPos>_fPrePosition)THEN
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fSetPos;
		ELSE
			stAxis.stPLCTONC.stEndPosition.fPosition:=_fPrePosition;
		END_IF
	END_IF
	stAxis.stPLCTONC.fTargetVelocity:=_fSetVelo;
	
    stAxis.stPLCTONC.stEndPosition.fAccleration:=_fAcc;
    stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;
    stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk;
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	    _fDistance:=stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition;
	ELSE
		_fDistance:=ABS(stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition);
	END_IF
	
	IF (_fDistance<=0) THEN      //11.26
		
		IF (LTRUNC(stAxis.stPLCTONC.stEndPosition.fPosition)=LTRUNC(_fSetPos))THEN
			_bSegDone:=TRUE;
		     RETURN ;
		ELSE
			_bSegOver:=TRUE;
		    RETURN ;
		END_IF
		IF (_fLastGap<>fGap)AND (stAxis.stAxisStatus.nNcCycleCounter<>0)THEN    //12.30  增加gap更新校验
			// _bParamError:=TRUE;
	        // nErrorID:=29681;
			_bNegPosStop:=TRUE;
			_fLastGap:=fGap;
	    END_IF
	END_IF

ELSE
	stAxis.stPLCTONC.stEndPosition.fPosition:=_fSetPos;
    
	stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
    stAxis.stPLCTONC.stEndPosition.fAccleration:=_fAcc;
    stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;
    stAxis.stPLCTONC.stEndPosition.fbJerk:=fJerk;
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	    _fDistance:=stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition;
	ELSE
		_fDistance:=ABS(stAxis.stPLCTONC.stEndPosition.fPosition-stAxis.stPLCTONC.stStartPosition.fPosition);
	END_IF
	
	IF (_fDistance<=0) THEN 
		_bSegDone:=TRUE;
		RETURN ;
	END_IF
END_IF 
//_fGapSet:=_pPremover^.stAxisStatus.stPathRef.fGap+stAxis.stAxisParam.fClampLength*0.5;
(*判断当前动子和前动子的间距
   1. <设定阀值，如果速度不相等，将当前动子速度设置为前动子速度
   2. >设定阀值，等待间距拉开 
*)

_fGapSet:=_pPremover^.stAxisParam.fClampLength*0.5 +_fGap;

IF _bIsGroupMember THEN   //03.31  重新更新_fGapSet 控制前后动子的间距
	_fGapSet:=_fGroupInGap*0.5;
END_IF

IF (_pPremover^.stNcTOPLC.nAxisId<>0) AND _fPhyRealDis<=_fGapSet AND stAxis.stAxisStatus.bEmStopping THEN   // 05.18
	IF ABS(stAxis.stNcTOPLC.fActPos-stAxis.stCodToNCParam.fActualPos)>500 THEN   //07.13
		stAxis.stNcTOPLC.fActPos:=stAxis.stCodToNCParam.fActualPos;
	END_IF
	RETURN;
	
END_IF

IF (_pPremover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid  AND (stAxis.stAxisStatus.nNcCycleCounter=0)   THEN    //01.15
	IF (_fRealDis>=_fGapSet) THEN  //02.20 保证前动子路径动态更新
		(*stAxis.stPLCTONC.fDealtGap:=_fRealDis-_fGapSet+fDealtGap+0.5*_pPremover^.stPLCTONC.fTargetVelocity*_pPremover^.stPLCTONC.fTargetVelocity/_fDec;   //计算dealtGap 06.30
        IF  stAxis.stPLCTONC.fDealtGap<>0 THEN 
			IF (_fRealDis<=(_fGapSet+stAxis.stPLCTONC.fDealtGap))THEN
				 IF (stAxis.stPLCTONC.fTargetVelocity>_pPremover^.stPLCTONC.fTargetVelocity)AND(_pPremover^.stPLCTONC.fTargetVelocity<>0)THEN
					stAxis.stPLCTONC.fTargetVelocity:=_pPremover^.stPLCTONC.fTargetVelocity;
				 END_IF
		    END_IF
		ELSE
			IF (_fRealDis<=(_fGapSet+fDealtGap))THEN
				 IF (stAxis.stPLCTONC.fTargetVelocity>_pPremover^.stPLCTONC.fTargetVelocity)AND(_pPremover^.stPLCTONC.fTargetVelocity<>0)THEN
					stAxis.stPLCTONC.fTargetVelocity:=_pPremover^.stPLCTONC.fTargetVelocity;
				 END_IF
		    END_IF
		END_IF*)
		IF (_fRealDis<=(_fGapSet+fDealtGap))THEN
			 IF (stAxis.stPLCTONC.fTargetVelocity>_pPremover^.stPLCTONC.fTargetVelocity)AND(_pPremover^.stPLCTONC.fTargetVelocity<>0)THEN
				
				stAxis.stPLCTONC.fTargetVelocity:=_pPremover^.stPLCTONC.fTargetVelocity;
				
			 END_IF
		END_IF
	ELSE
		RETURN ;
	END_IF
    IF _fPhyRealDis<_fGapSet THEN   //07.17
		RETURN ;
	END_IF
END_IF 



// 06.18 增加前后动子重新触发指令时速度限制
(*IF (_pPremover^.stNcTOPLC.nAxisId<>0)AND NOT bCollsionNotValid  THEN
   IF (stAxis.stAxisStatus.nNcCycleCounter<>0)  THEN    //01.15
		IF _pPremover^.stAxisStatus.nNcCycleCounter<>0 AND (stAxis.stAxisStatus.stPathRef.fTargetVelocity=_pPremover^.stAxisStatus.stPathRef.fTargetVelocity) THEN
			IF  stAxis.stPLCTONC.fDealtGap<>0 THEN 
				IF _fSetVelo>stAxis.stAxisStatus.stPathRef.fTargetVelocity AND (_fRealDis<=(_fGapSet+stAxis.stPLCTONC.fDealtGap)) THEN
					stAxis.stPLCTONC.fTargetVelocity:=stAxis.stAxisStatus.stPathRef.fTargetVelocity;
				END_IF
			ELSE
				IF _fSetVelo>stAxis.stAxisStatus.stPathRef.fTargetVelocity AND (_fRealDis<=(_fGapSet+fDealtGap)) THEN
					stAxis.stPLCTONC.fTargetVelocity:=stAxis.stAxisStatus.stPathRef.fTargetVelocity;
				END_IF
			END_IF
		END_IF
   END_IF 

END_IF*)
// 09.28 加速度和减速度校验
IF stAxis.stAxisStatus.nNcCycleCounter<>0 AND stAxis.stNcTOPLC.fActVelo >0 THEN
	_fPosMin:=0.5*stAxis.stPLCTONC.stStartPosition.fVelocity*stAxis.stPLCTONC.stStartPosition.fVelocity/_fDec;
	IF _fPosMin>_fDistance THEN
		_fNewDec:=0.5*stAxis.stPLCTONC.stStartPosition.fVelocity*stAxis.stPLCTONC.stStartPosition.fVelocity/_fDistance;
		IF (_fNewDec>stAxis.stAxisParam.stDynamicDefault.fMaxAccelaration)THEN
		    _fNewDec:=stAxis.stAxisParam.stDynamicDefault.fMaxAccelaration;
	    END_IF
		stAxis.stPLCTONC.stEndPosition.fAccleration:=_fNewDec;
		stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fNewDec;
	END_IF
END_IF
// 09.28 加速度和减速度校验

IF NOT bCollsionNotValid THEN 
	IF (stAxis.stPLCTONC.stEndPosition.fPosition<>fPosition) THEN 
		_bTargetDiff:=TRUE;
	ELSE
		_bTargetDiff:=FALSE;
	END_IF 
END_IF 
//_fStartPos:=stAxis.stPLCTONC.stStartPosition.fPosition;

(****************** path time calculate*******************)
IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
	stAxis.stAxisStatus.bPositiveDirection:=TRUE;
	stAxis.stAxisStatus.bNegativeDirection:=FALSE;
ELSE
    stAxis.stAxisStatus.bPositiveDirection:=FALSE;
	stAxis.stAxisStatus.bNegativeDirection:=TRUE;
END_IF

//A_AbortedCollisionCheck();  //10.30
IF _bIsCollisionCheck THEN     //10.30  指令打断碰撞检测
	A_AbortedCollisionCheck();  //10.30
	stAxis.stPLCTONC.stEndPosition.fPosition:=_fLastEndPos;
	RETURN;
END_IF


_bPreGeneSegDone:=TRUE;
_fLastGap:=fGap;      //12.26
stAxis.stAxisStatus.bEmStopping:=FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_PathUpdateCheck" Id="{219a7b7a-1dc7-4391-8123-a050dd35d5af}">
      <Implementation>
        <ST><![CDATA[IF (_pPremover^.stNcTOPLC.nAxisId<>0)THEN
	IF(_pPremover^.stAxisStatus.nNcCycleCounter=0)THEN  //静止
		IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
			_fDyPathDis1:= _pPremover^.stNcTOPLC.fActPos-stAxis.stPLCTONC.stEndPosition.fPosition-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
			_fUpDis:=_pPremover^.stNcTOPLC.fActPos-_pPremover^.stAxisParam.fClampLength*0.5-_fGap-stAxis.stNcTOPLC.fActPos;  //10.24
			
			IF _bIsGroupMember THEN  //03.31 
				_fDyPathDis1:= _pPremover^.stNcTOPLC.fActPos-stAxis.stPLCTONC.stEndPosition.fPosition-_fGroupInGap;
			END_IF
			IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
				_fDyPathDis1:= _pPremover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stPLCTONC.stEndPosition.fPosition-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
				IF _bIsGroupMember THEN  //03.31 
					_fDyPathDis1:= _pPremover^.stNcTOPLC.fActPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stPLCTONC.stEndPosition.fPosition-_fGroupInGap;
				END_IF
			END_IF
			
		ELSE
			//_fDyPathDis1:= stAxis.stPLCTONC.stEndPosition.fPosition-_pPremover^.stNcTOPLC.fActPos+_pPremover^.stAxisParam.fGap+_pPremover^.stAxisParam.fClampLength*0.5+_fClampLength;
			_fDyPathDis1:= stAxis.stPLCTONC.stEndPosition.fPosition-_pPremover^.stNcTOPLC.fActPos-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
			
			_fUpDis:=stAxis.stNcTOPLC.fActPos-(_pPremover^.stNcTOPLC.fActPos+_pPremover^.stAxisParam.fClampLength*0.5+_fGap);  //10.24
			
			IF _bIsGroupMember THEN  //03.31 
				_fDyPathDis1:=stAxis.stPLCTONC.stEndPosition.fPosition- _pPremover^.stNcTOPLC.fActPos-_fGroupInGap;
			END_IF
			IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
				_fDyPathDis1:= stAxis.stPLCTONC.stEndPosition.fPosition+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stNcTOPLC.fActPos-_pPremover^.stAxisParam.fClampLength*0.5-_fGap;
				IF _bIsGroupMember THEN  //03.31 
					_fDyPathDis1:= stAxis.stPLCTONC.stEndPosition.fPosition+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stNcTOPLC.fActPos-_fGroupInGap;
				END_IF
			END_IF
		END_IF 
	ELSE
		// 04.15 增加运动方向判断
		IF (_eDirection=E_Direction.DIRECTION_POSITIVE)AND _pPremover^.stAxisStatus.bNegativeDirection THEN
			RETURN;
		END_IF
		IF (_eDirection=E_Direction.DIRECTION_NEGATIVE)AND _pPremover^.stAxisStatus.bPositiveDirection THEN
			RETURN;
		END_IF
		// 04.15 增加运动方向判断
		IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN 
			IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN 
				IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
					//_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fClampLength;
					_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGap;
					_fUpDis:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap-stAxis.stNcTOPLC.fActPos;  //10.24
					
					IF _bIsGroupMember THEN  //03.31 
						_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGroupInGap;
					END_IF
					IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
						_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGap;
						IF _bIsGroupMember THEN  //03.31
							_fDyPathDis1:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGroupInGap;
						END_IF
					END_IF
				ELSE
					//_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+_fClampLength;
					_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap;
					_fUpDis:= stAxis.stNcTOPLC.fActPos-(_pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+_fGap);  //10.24
					
					IF _bIsGroupMember THEN  //03.31 
						_fDyPathDis1:= stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGroupInGap;
					END_IF
					IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
						_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap;
						IF _bIsGroupMember THEN  //03.31
							_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGroupInGap;
						END_IF
					END_IF
				END_IF 
			ELSIF(stAxis.stAxisStatus.stPathRef._nPathSegmentNum=2)THEN 
				IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
					//_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fClampLength;
					_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGap;
					_fUpDis:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap-stAxis.stNcTOPLC.fActPos;  //10.24
					
					IF _bIsGroupMember THEN  //03.31 
						_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGroupInGap;
					END_IF
					IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
						_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGap;
						IF _bIsGroupMember THEN  //03.31
							_fDyPathDis1:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGroupInGap;
						END_IF
					END_IF
				ELSE
					//_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+_fClampLength;
					_fDyPathDis1:= stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap;
					_fUpDis:= stAxis.stNcTOPLC.fActPos-(_pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+_fGap);  //10.24
					IF _bIsGroupMember THEN  //03.31 
						_fDyPathDis1:= stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGroupInGap;
					END_IF
					IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
						_fDyPathDis1:= stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos-_fGap;
						IF _bIsGroupMember THEN  //03.31
							_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGroupInGap;
						END_IF
					END_IF
				END_IF
			
			ELSE
				;
			
			END_IF
		ELSIF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=2)THEN
			IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN 
				IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
					
					_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGap;
					_fUpDis:= _pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap-stAxis.stNcTOPLC.fActPos;  //10.24
					IF _bIsGroupMember THEN  //03.31 
						_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGroupInGap;
					END_IF
					IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
						_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGap;
						IF _bIsGroupMember THEN  //03.31
							_fDyPathDis1:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGroupInGap;
						END_IF
					END_IF
				ELSE
					
					_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap;
					_fUpDis:= stAxis.stNcTOPLC.fActPos-(_pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos+_fGap);  //10.24
					IF _bIsGroupMember THEN  //03.31 
						_fDyPathDis1:= stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGroupInGap;
					END_IF
					IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
						_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap;
						IF _bIsGroupMember THEN  //03.31
							_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGroupInGap;
						END_IF
					END_IF
				END_IF 
			ELSIF(stAxis.stAxisStatus.stPathRef._nPathSegmentNum=2)THEN 
				IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
					
					_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGap;
					_fUpDis:= _pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap-stAxis.stNcTOPLC.fActPos;  //10.24
					
					IF _bIsGroupMember THEN  //03.31 
						_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGroupInGap;
					END_IF
					IF (_pPremover^.stNcTOPLC.fActPos<stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
						_fDyPathDis1:= _pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGap;
						IF _bIsGroupMember THEN  //03.31
							_fDyPathDis1:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stNcTOPLC.fModuloFactor-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGroupInGap;
						END_IF
					END_IF
				ELSE
					
					_fDyPathDis1:= stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap;
					_fUpDis:= stAxis.stNcTOPLC.fActPos-(_pPremover^.stAxisStatus.stPathRef.aSafePath[0].fEndPos+_fGap);  //10.24
					
					IF _bIsGroupMember THEN  //03.31 
						_fDyPathDis1:= stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGroupInGap;
					END_IF
					IF (_pPremover^.stNcTOPLC.fActPos>stAxis.stNcTOPLC.fActPos)AND(_nSysType=3)THEN
						_fDyPathDis1:= stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisStatus.stPathRef.aSafePath[1].fEndPos-_fGap;
						IF _bIsGroupMember THEN  //03.31
							_fDyPathDis1:=stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stNcTOPLC.fModuloFactor-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGroupInGap;
						END_IF
					END_IF
				END_IF
			
			ELSE
				;
			
			END_IF
		ELSE
			;
		END_IF
				
	END_IF
END_IF 


// 09.11 增加实时距离判断追尾程序
_fPreDecDis:= stAxis.stPLCTONC.fTargetVelocity* stAxis.stPLCTONC.fTargetVelocity/_fDec;

(*IF (_pPremover^.stNcTOPLC.nAxisId<>0)THEN 
		_fSafeDis:=_fRealDis-_fGap-_fClampLength-_fPreDecDis; 
ELSE
		_fSafeDis:=10;
END_IF*)




IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN 
   _fStartTime:=stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTotalTime-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTd-_fCurrentTime;
  
ELSIF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=2)THEN 
	_fStartTime:=stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fTotalTime-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fTd-_fCurrentTime;
ELSE
	;
END_IF


// 计算更新路径数据
IF (_pPremover^.stNcTOPLC.nAxisId<>0) THEN
	IF _fUpDis>0 AND _fDyPathDis1>10   THEN
	   _stTimeInfo:= _fbTraPlanning.M_TShaped(
					fVeloStart:=stAxis.stNcTOPLC.fActVelo , 
					fVeloEnd:=0 , 
					fTargetVelo:=stAxis.stPLCTONC.fTargetVelocity , 
					fDistance:=_fUpDis , 
					fAccleration:= _fAcc, 
					fDeceleration:=_fDec );
					
	   //分类讨论  只考虑前动子在加速段情况，减速段和匀速段不考虑
	   // 后动子 分为加速段 匀速段 和减速段三种情况
	   // 后动子在加速段
	   _fPreTime:=UDINT_TO_LREAL(_pPremover^.stAxisStatus.nNcCycleCounter)*GVL_MC.rNcCycle;
	   
	   IF _fPreTime<_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fTa 
             AND  _pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fStartVelo<_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fExpVelo THEN   // 前动作子加速段
		   IF _fCurrentTime<stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTa THEN //后动子加速段 分为两种情况
			   IF _pPremover^.stNcTOPLC.fActVelo< stAxis.stNcTOPLC.fActVelo THEN
			      _fSafeDis:=_fRealDis-_fGap-_fClampLength-_fPreDecDis;
		       ELSE   // 前动子速度大于后动子实际速度 直接更新
				   _fSafeDis:=10;
			   END_IF
		   ELSIF _fCurrentTime<=(stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTa+stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fTv) THEN  //匀速段
			   _fSafeDis:=_fRealDis-_fGap-_fClampLength-_fPreDecDis;
		   
		   ELSE   //减速段
			   _fUpPreTaLeft:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fTa-_fPreTime;
			   _fPreVMax:=_fUpPreTaLeft*_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fAccleration+_pPremover^.stNcTOPLC.fActVelo;
			   _fPreDis:=0.5*(_pPremover^.stNcTOPLC.fActVelo+_fPreVMax)*_fUpPreTaLeft;
			   _fVmax:=stAxis.stNcTOPLC.fActVelo+_stTimeInfo.fTa*_fAcc;
               IF _fUpPreTaLeft<= _stTimeInfo.fTa THEN 
				   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_fUpPreTaLeft;
               ELSIF _fUpPreTaLeft<=(_stTimeInfo.fTa+_stTimeInfo.fTv) THEN
                  
				   _fUpTv:=_fUpPreTaLeft-_stTimeInfo.fTa;
                   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_stTimeInfo.fTa+_fVmax*_fUpTv;
			   ELSE
				   _fUpTd:=_fUpPreTaLeft-_stTimeInfo.fTv-_stTimeInfo.fTa;
				   _fVend:=_fVmax-_fUpTd*_fDec;
				   _fCuDis:=0.5*(stAxis.stNcTOPLC.fActVelo+_fVmax)*_stTimeInfo.fTa+_fVmax*_stTimeInfo.fTv+0.5*(_fVend+_fVmax)*_fUpTd;
			   END_IF
			   _fSafeDis:=_fRealDis-_fGap-_fClampLength+_fPreDis-_fCuDis;
			   
		   END_IF
	   ELSE
		    _fSafeDis:=10;
	   END_IF
	END_IF
END_IF


]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_StopPathGerenation" Id="{d6311faa-364a-4dde-8154-8974f4a6d171}">
      <Implementation>
        <ST><![CDATA[
_fPostion:=0.5*stAxis.stNcTOPLC.fActVelo*stAxis.stNcTOPLC.fActVelo/_fDec;
IF stAxis.stAxisStatus.bPositiveDirection THEN
	 stAxis.stPLCTONC.stEndPosition.fPosition:=_fPostion+stAxis.stNcTOPLC.fActPos;
ELSE
	stAxis.stPLCTONC.stEndPosition.fPosition:=stAxis.stNcTOPLC.fActPos-_fPostion;
END_IF

stAxis.stPLCTONC.fTargetVelocity:=stAxis.stNcTOPLC.fActVelo;
stAxis.stPLCTONC.stEndPosition.fVelocity:=0;
stAxis.stPLCTONC.stEndPosition.fAccleration:=_fDec;
stAxis.stPLCTONC.stEndPosition.fDeceleration:=_fDec;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_UpstateStatus" Id="{12f93f52-e80c-4c44-a9d7-98d0fca71c58}">
      <Implementation>
        <ST><![CDATA[stAxis.stAxisStatus.nCycleCounter:=_nCycleCount;
//stAxis.stAxisStatus.nCollState.1:=_bCollisionChecked;

stAxis.stAxisStatus.bCollisionStoped:=_bCollisionChecked;

//02.24 NC匹配task
_nLastCycleCounter:=_nCycleCount;
_nLastNcCycleCounter:=stAxis.stAxisStatus.nNcCycleCounter_WP;]]></ST>
      </Implementation>
    </Action>
