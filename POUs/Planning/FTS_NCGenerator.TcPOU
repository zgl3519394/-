												 END_IF
											 END_IF
								END_IF 
							ELSE
								IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
									  IF NOT stAxis.stPLCTONC.bRoadDirection  THEN   //正向 		
											   IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
												   IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
														 IF ((_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stPLCTONC.fRoad1_Length)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
												   ELSE
														IF ((_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stPLCTONC.fRoad1_Length)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
														
												   END_IF
											   ELSE
													IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
													   IF ((_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stPLCTONC.fRoad1_Length)<_fGapSet) THEN
														   A_UpdateNewTarPos();
														  // stAxis.stAxisStatus.bSynStopping:=TRUE;
														END_IF
													ELSE
														IF ((_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stPLCTONC.fRoad1_Length)<_fGapSet) THEN
														   A_UpdateNewTarPos();
														   //stAxis.stAxisStatus.bSynStopping:=TRUE;
														END_IF
													END_IF
											   END_IF
									  ELSE
										   IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
												    IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
														 IF ((stAxis.stPLCTONC.fRoad1_Length+stAxis.stPLCTONC.fRoad2_Length-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
													ELSE
														 IF ((stAxis.stPLCTONC.fRoad1_Length+stAxis.stPLCTONC.fRoad2_Length-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
														
													END_IF
										   ELSE
													IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
														 IF ((stAxis.stPLCTONC.fRoad1_Length+stAxis.stPLCTONC.fRoad2_Length-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
													ELSE
														 IF ((stAxis.stPLCTONC.fRoad1_Length+stAxis.stPLCTONC.fRoad2_Length-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
														
													END_IF
										   END_IF
									  END_IF
								ELSE
									   IF NOT stAxis.stPLCTONC.bRoadDirection  THEN   //正向 		
											   IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
												   IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
														 IF ((_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
													     END_IF
	
												    ELSE
														IF ((_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														END_IF
														
													END_IF
											   ELSE
													IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
													   IF ((_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
														   A_UpdateNewTarPos();
														   //stAxis.stAxisStatus.bSynStopping:=TRUE;
														END_IF
													
													ELSE
														IF ((_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos)<_fGapSet) THEN
														   A_UpdateNewTarPos();
														   //stAxis.stAxisStatus.bSynStopping:=TRUE;
														END_IF
													END_IF
											   END_IF
									   ELSE
										   IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
												   IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
														 IF ((stAxis.stPLCTONC.fRoad2_Length-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
												   ELSE
														 IF ((stAxis.stPLCTONC.fRoad2_Length-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
														
												   END_IF
										   ELSE
													IF (stAxis.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
														 IF ((stAxis.stPLCTONC.fRoad2_Length-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
													ELSE
														 IF ((stAxis.stPLCTONC.fRoad2_Length-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos+stAxis.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos)<_fGapSet) THEN
															A_UpdateNewTarPos();
															//stAxis.stAxisStatus.bSynStopping:=TRUE;
														 END_IF
													END_IF
										   END_IF
									   END_IF
								END_IF 
				            END_IF
				END_IF  
					
				//END_IF
			END_IF
	    END_IF
	ELSE       //nextroad前置有动子 
        //IF (_pNextRoadPremover^.stNcTOPLC.nAxisId<>0)AND (stAxis.stNcTOPLC.nCuRoadID<>_pNextRoadPremover^.stNcTOPLC.nCuRoadID)THEN 
		IF (_pNextRoadPremover^.stNcTOPLC.nAxisId<>0)AND (stAxis.stNcTOPLC.nCuRoadID<>_pNextRoadPremover^.stNcTOPLC.nCuRoadID) 
           AND   _pNextRoadPremover^.stAxisStatus.bSynStopping AND NOT stAxis.stAxisStatus.bSynStopping THEN
             IF (_pNextRoadPremover^.stPLCTONC.stStartPosition.nRoadID<>_pNextRoadPremover^.stPLCTONC.stEndPosition.nRoadID)THEN
				  IF (_pNextRoadPremover^.stPLCTONC.stStartPosition.nRoadID=stAxis.stPLCTONC.stStartPosition.nRoadID)THEN  //起点road相同
					   IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
						   IF ((_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
								A_NextPathUpdateNewTarPos();
								//stAxis.stAxisStatus.bSynStopping:=TRUE;
						   END_IF
					   ELSE
						   IF ((stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet)THEN	
								A_NextPathUpdateNewTarPos();
								//stAxis.stAxisStatus.bSynStopping:=TRUE;
						   END_IF
					   END_IF
				  ELSE
					  IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
						   IF NOT stAxis.stPLCTONC.bRoadDirection  THEN
							   IF ((_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stPLCTONC.fRoad1_Length-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
								   A_NextPathUpdateNewTarPos();
								   //stAxis.stAxisStatus.bSynStopping:=TRUE;
						       END_IF
				
						   ELSE
							   IF ((stAxis.stPLCTONC.fRoad2_Length-_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stPLCTONC.fRoad1_Length-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
									A_NextPathUpdateNewTarPos();
									//stAxis.stAxisStatus.bSynStopping:=TRUE;
								END_IF
						   END_IF
					  ELSE
						   IF NOT stAxis.stPLCTONC.bRoadDirection  THEN
								IF ((stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet)THEN		
									A_NextPathUpdateNewTarPos();
									//stAxis.stAxisStatus.bSynStopping:=TRUE;
								END_IF
						   ELSE
								IF ((stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stPLCTONC.fRoad2_Length-_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet)THEN		
									A_NextPathUpdateNewTarPos();
									//stAxis.stAxisStatus.bSynStopping:=TRUE;
								END_IF
							
						   END_IF
					  END_IF
				  END_IF
			 ELSE
					   IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
						   IF NOT stAxis.stPLCTONC.bRoadDirection  THEN
								IF ((_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stPLCTONC.fRoad1_Length-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
									A_NextPathUpdateNewTarPos();
									//stAxis.stAxisStatus.bSynStopping:=TRUE;
								END_IF
						   ELSE
								IF ((stAxis.stPLCTONC.fRoad2_Length-_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stPLCTONC.fRoad1_Length-stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet) THEN
									A_NextPathUpdateNewTarPos();
									//stAxis.stAxisStatus.bSynStopping:=TRUE;
								END_IF
						   END_IF
					   ELSE   //负向
						   IF NOT stAxis.stPLCTONC.bRoadDirection  THEN
								IF ((stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet)THEN		
									A_NextPathUpdateNewTarPos();
									//stAxis.stAxisStatus.bSynStopping:=TRUE;
								END_IF
							ELSE
								IF ((stAxis.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos+stAxis.stPLCTONC.fRoad2_Length-_pNextRoadPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos)<_fGapSet)THEN		
									A_NextPathUpdateNewTarPos();
									//stAxis.stAxisStatus.bSynStopping:=TRUE;
								END_IF
							
							END_IF
					   END_IF  
			 END_IF
			  
		END_IF
    END_IF   

END_IF


A_EStop();   //04.07注释
]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_TShaped" Id="{4139f278-0348-4b3e-b6ec-e75e8e684762}">
      <Implementation>
        <ST><![CDATA[_fStartPos:=stAxis.stNcTOPLC.fActPos;
_stPathRef:=_stNoPathRef;


IF (_fDistance>0)THEN
	_stTimeInfo:=_fbAxis.M_TShaped(
					fVeloStart:=_fVeloStart , 
					fVeloEnd:= _fVeloEnd, 
					fTargetVelo:=_fTargetVelo , 
					fDistance:=_fDistance, 
					fAccleration:=_fAcc , 
					fDeceleration:=_fDec );
ELSE
	RETURN ;
END_IF 

_stPathRef._nPathSegmentNum:=1;
_stPathRef.aExecutablePath[0].fTa:=_stTimeInfo.fTa;
_stPathRef.aExecutablePath[0].fTv:=_stTimeInfo.fTv;
_stPathRef.aExecutablePath[0].fTd:=_stTimeInfo.fTd;
_stPathRef.aExecutablePath[0].fTotalTime:=_stTimeInfo.fT3;
_stPathRef.aExecutablePath[0].fStartVelo:=_fVeloStart;
_stPathRef.aExecutablePath[0].fExpVelo:=_fTargetVelo;
_stPathRef.aExecutablePath[0].fEndVelo:=_fVeloEnd;
_stPathRef.aExecutablePath[0].fAccleration:=_fAcc ;
_stPathRef.aExecutablePath[0].fDeceleration:=_fDec;


_stPathRef.aExecutablePath[0].fStartPos:=_fStartPos;
IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
    _stPathRef.aExecutablePath[0].fEndPos:=_fDistance+_fStartPos;
	_eSetDirection:=E_Direction.DIRECTION_POSITIVE;
	//04.08 终点位置转换
	IF (stAxis.stPLCTONC.nRoadID_1<>0) AND (stAxis.stPLCTONC.nRoadID_2<>0)THEN   
	    IF (stAxis.stPLCTONC.stStartPosition.nRoadID=stAxis.stPLCTONC.nRoadID_2)THEN   
				 IF NOT stAxis.stPLCTONC.bRoadDirection  THEN   //正向 
			         _stPathRef.aExecutablePath[0].fEndPos:=_fDistance+_fStartPos;
					 _eSetDirection:=E_Direction.DIRECTION_POSITIVE;
				 ELSE
					 _stPathRef.aExecutablePath[0].fEndPos:=_fStartPos-_fDistance;
					 _eSetDirection:=E_Direction.DIRECTION_NEGATIVE;
				 END_IF
		 END_IF
	END_IF 
ELSE
	_stPathRef.aExecutablePath[0].fEndPos:=_fStartPos-_fDistance;
	_eSetDirection:=E_Direction.DIRECTION_NEGATIVE;
	//04.28  终点位置转换
	IF (stAxis.stPLCTONC.nRoadID_1<>0) AND (stAxis.stPLCTONC.nRoadID_2<>0)THEN   
	    IF (stAxis.stPLCTONC.stStartPosition.nRoadID=stAxis.stPLCTONC.nRoadID_2)THEN   
				 IF NOT stAxis.stPLCTONC.bRoadDirection  THEN   //正向 
			         _stPathRef.aExecutablePath[0].fEndPos:=_fDistance+_fStartPos;
					 _eSetDirection:=E_Direction.DIRECTION_POSITIVE;
				 ELSE
					 _stPathRef.aExecutablePath[0].fEndPos:=_fStartPos-_fDistance;
					 _eSetDirection:=E_Direction.DIRECTION_NEGATIVE;
				 END_IF
		 END_IF
	END_IF 
END_IF

_stPathRef.aSafePath:=_stPathRef.aExecutablePath;
IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		
   _stPathRef.aSafePath[0].fStartPos:=_stPathRef.aExecutablePath[0].fStartPos-_fGap;
   _stPathRef.aSafePath[0].fEndPos:=_stPathRef.aExecutablePath[0].fEndPos-_fGap;
   
   //04.08 终点位置转换
	IF (stAxis.stPLCTONC.nRoadID_1<>0) AND (stAxis.stPLCTONC.nRoadID_2<>0)THEN   
	    IF (stAxis.stPLCTONC.stStartPosition.nRoadID=stAxis.stPLCTONC.nRoadID_2)THEN   
				 IF NOT stAxis.stPLCTONC.bRoadDirection  THEN   //正向 
			         _stPathRef.aSafePath[0].fStartPos:=_stPathRef.aExecutablePath[0].fStartPos-_fGap;
                     _stPathRef.aSafePath[0].fEndPos:=_stPathRef.aExecutablePath[0].fEndPos-_fGap;
					 
				 ELSE
					 _stPathRef.aSafePath[0].fStartPos:=_stPathRef.aExecutablePath[0].fStartPos+_fGap;
                      _stPathRef.aSafePath[0].fEndPos:=_stPathRef.aExecutablePath[0].fEndPos+_fGap;
					  
				 END_IF
		 END_IF
	END_IF 
ELSE 
   _stPathRef.aSafePath[0].fStartPos:=_stPathRef.aExecutablePath[0].fStartPos+_fGap;
   _stPathRef.aSafePath[0].fEndPos:=_stPathRef.aExecutablePath[0].fEndPos+_fGap;
   //04.08 终点位置转换
	IF (stAxis.stPLCTONC.nRoadID_1<>0) AND (stAxis.stPLCTONC.nRoadID_2<>0)THEN   
	    IF (stAxis.stPLCTONC.stStartPosition.nRoadID=stAxis.stPLCTONC.nRoadID_2)THEN   
				 IF NOT stAxis.stPLCTONC.bRoadDirection  THEN   //正向 
			         _stPathRef.aSafePath[0].fStartPos:=_stPathRef.aExecutablePath[0].fStartPos-_fGap;
                     _stPathRef.aSafePath[0].fEndPos:=_stPathRef.aExecutablePath[0].fEndPos-_fGap;
					
				 ELSE
					 _stPathRef.aSafePath[0].fStartPos:=_stPathRef.aExecutablePath[0].fStartPos+_fGap;
                      _stPathRef.aSafePath[0].fEndPos:=_stPathRef.aExecutablePath[0].fEndPos+_fGap;
					  
				 END_IF
		 END_IF
	END_IF 
END_IF

_stPathRef.fTargetVelocity:=_fTargetVelo;


IF (_nPathSegment=2)THEN 
	IF (_fDistance_2>0)THEN
		_stTimeInfo_2:=_fbAxis.M_TShaped(
						fVeloStart:=_fVeloStart_2 , 
						fVeloEnd:= _fVeloEnd_2, 
						fTargetVelo:=_fTargetVelo_2 , 
						fDistance:=_fDistance_2, 
						fAccleration:=_fAcc_2 , 
						fDeceleration:=_fDec_2 );
	END_IF 
	
	_stPathRef._nPathSegmentNum:=2;
	_stPathRef.aExecutablePath[1].fTa:=_stTimeInfo_2.fTa;
	_stPathRef.aExecutablePath[1].fTv:=_stTimeInfo_2.fTv;
	_stPathRef.aExecutablePath[1].fTd:=_stTimeInfo_2.fTd;
	_stPathRef.aExecutablePath[1].fTotalTime:=_stTimeInfo_2.fT3;
	_stPathRef.aExecutablePath[1].fStartVelo:=_fVeloStart_2;
	_stPathRef.aExecutablePath[1].fExpVelo:=_fTargetVelo_2;
	_stPathRef.aExecutablePath[1].fEndVelo:= _fVeloEnd_2;
	_stPathRef.aExecutablePath[1].fAccleration:=_fAcc_2 ;
	_stPathRef.aExecutablePath[1].fDeceleration:=_fDec_2;
	_stPathRef.aExecutablePath[1].fStartPos:=_stPathRef.aExecutablePath[0].fEndPos;
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		_stPathRef.aExecutablePath[1].fEndPos:=_fDistance_2+_stPathRef.aExecutablePath[1].fStartPos;
	ELSE
		_stPathRef.aExecutablePath[1].fEndPos:=_stPathRef.aExecutablePath[1].fStartPos-_fDistance_2;
	END_IF
	
	_stPathRef.aSafePath:=_stPathRef.aExecutablePath;
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
			
	   _stPathRef.aSafePath[1].fStartPos:=_stPathRef.aExecutablePath[1].fStartPos-_fGap;
	   _stPathRef.aSafePath[1].fEndPos:=_stPathRef.aExecutablePath[1].fEndPos-_fGap;
	ELSE 
	   _stPathRef.aSafePath[1].fStartPos:=_stPathRef.aExecutablePath[1].fStartPos+_fGap;
	   _stPathRef.aSafePath[1].fEndPos:=_stPathRef.aExecutablePath[1].fEndPos+_fGap;
	END_IF
	
	_stPathRef.fTargetVelocity:=_fTargetVelo;
    _stPathRef.fDealtInPos:=  _fPosIn;       //11.29
END_IF
_stPathRef.fGap:=_fGap;
_stPathRef.fSetGap:=stAxis.stAxisStatus.stPathRef.fSetGap;

_stPathRef.bCalculateDone:=TRUE;
stAxis.stAxisStatus.stPathRef:=_stPathRef;

_bCalculateDone:=TRUE;
_fTime:=0;
_nIndex:=0;
stAxis.stAxisStatus.nNcCycleCounter:=0;
IF _bEstopping THEN    //03.03
	stAxis.stAxisStatus.bEmStopping:=TRUE;
END_IF

_stLastAxis_Point.fPosition:=stAxis.stNcTOPLC.fActPos;//03.14

IF GVL_MC.cDebug  THEN
		//_sMessage:=FC_StrContact(stAxis,'NC generate path');
	    // ADSLOGSTR(ADSLOG_MSGTYPE_HINT, _sMessage, '');
	_sMessage2:=FC_StrContactEx(stAxis,'NC cla path');
	 ADSLOGSTR(ADSLOG_MSGTYPE_HINT, _sMessage2, '');
	;	 
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_TShapedPosition" Id="{45987908-60e2-4541-9d8e-0ee9cc688680}">
      <Implementation>
        <ST><![CDATA[ //_nSysType:=stAxis.stPLCTONC.nSysType;   //01.13
 _fRoad1_Lenth:=stAxis.stPLCTONC.fRoad1_Length;
 _fRoad2_Lenth:=stAxis.stPLCTONC.fRoad2_Length;
 
stAxis.stNcTOPLC.nAxisState:=6;
_fTime:=_fTime+fCycleTime;
stAxis.stAxisStatus.nNcCycleCounter:=stAxis.stAxisStatus.nNcCycleCounter+1;

_stAxis_Point:=_fbAxis.M_GetPosition(
						fTime:=_fTime , 
						fTa:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fTa , 
						fTv:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fTv , 
						fTd:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fTd , 
						fVeloStart:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fStartVelo , 
						fVeloEnd:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fEndVelo , 
						fTargetVelo:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fExpVelo , 
						fAccleration:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fAccleration , 
						fDeceleration:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fDeceleration ,   //02.21
						fInitalPos:=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fStartPos ,
						eDirection:= _eSetDirection);
						//eDirection:= _eDirection);  //04.08


//  实时位置、速度处理
IF (_nSysType=1)OR(_nSysType=4)	THEN    //接驳线和分叉线
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		IF (stAxis.stPLCTONC.stStartPosition.nRoadID<>stAxis.stPLCTONC.stEndPosition.nRoadID)THEN    //id不相同处理
			IF (_stAxis_Point.fPosition<_fRoad1_Lenth)THEN  //04.16
				//stAxis.stNcTOPLC.fActPos:=floor(_stAxis_Point.fPosition);  //04.19
				stAxis.stNcTOPLC.fActPos:=LTRUNC(_stAxis_Point.fPosition);   //04.19
				stAxis.stNcTOPLC.nCuRoadID:=stAxis.stPLCTONC.nRoadID_1;
			ELSE
				IF NOT stAxis.stPLCTONC.bRoadDirection THEN 
				    stAxis.stNcTOPLC.fActPos:=LTRUNC(FC_TransformPosition(fOffset:=-_fRoad1_Lenth , fPosition:=_stAxis_Point.fPosition ));
				ELSE
					_fPosTemp:=FC_TransformPosition(fOffset:=-_fRoad1_Lenth , fPosition:=_stAxis_Point.fPosition );
					 stAxis.stNcTOPLC.fActPos:= LTRUNC(_fRoad2_Lenth-_fPosTemp);
				END_IF
				
				stAxis.stNcTOPLC.nCuRoadID:=stAxis.stPLCTONC.nRoadID_2;
			END_IF
			stAxis.stNcTOPLC.fSetVelo:=_stAxis_Point.fVelocity;  
			stAxis.stNcTOPLC.fActVelo:=_stAxis_Point.fVelocity;
		ELSE  //ID 相同
			IF (stAxis.stPLCTONC.stEndPosition.nRoadID=stAxis.stPLCTONC.nRoadID_1)THEN   //03.05
			    stAxis.stNcTOPLC.fActPos:=LTRUNC(_stAxis_Point.fPosition);
			    stAxis.stNcTOPLC.nCuRoadID:=stAxis.stPLCTONC.nRoadID_1;
			ELSE 
				
				stAxis.stNcTOPLC.fActPos:=LTRUNC(_stAxis_Point.fPosition);   //04.07
                stAxis.stNcTOPLC.nCuRoadID:=stAxis.stPLCTONC.nRoadID_2;
			END_IF
		    stAxis.stNcTOPLC.fSetVelo:=_stAxis_Point.fVelocity;  
			stAxis.stNcTOPLC.fActVelo:=_stAxis_Point.fVelocity;
		END_IF
	ELSE
		IF (stAxis.stPLCTONC.stStartPosition.nRoadID<>stAxis.stPLCTONC.stEndPosition.nRoadID)THEN    //id不相同处理
			IF (_stAxis_Point.fPosition>0)THEN  //04.16
				stAxis.stNcTOPLC.nCuRoadID:=stAxis.stPLCTONC.nRoadID_1;
				stAxis.stNcTOPLC.fActPos:=LTRUNC(_stAxis_Point.fPosition);
		
			ELSE
				IF NOT stAxis.stPLCTONC.bRoadDirection THEN     //正向
					stAxis.stNcTOPLC.fActPos:=LTRUNC(ABS(_stAxis_Point.fPosition));
				ELSE
					_fPosTemp:=ABS(_stAxis_Point.fPosition);
					stAxis.stNcTOPLC.fActPos:= LTRUNC(_fRoad2_Lenth-_fPosTemp);
				END_IF
				stAxis.stNcTOPLC.nCuRoadID:=stAxis.stPLCTONC.nRoadID_2;
			END_IF
            stAxis.stNcTOPLC.fSetVelo:=_stAxis_Point.fVelocity;  
			stAxis.stNcTOPLC.fActVelo:=_stAxis_Point.fVelocity;
		ELSE
			IF (stAxis.stPLCTONC.stEndPosition.nRoadID=stAxis.stPLCTONC.nRoadID_1)THEN 
				stAxis.stNcTOPLC.fActPos:=LTRUNC(_stAxis_Point.fPosition);
				stAxis.stNcTOPLC.nCuRoadID:=stAxis.stPLCTONC.nRoadID_1;
			ELSE
				stAxis.stNcTOPLC.fActPos:=LTRUNC(_stAxis_Point.fPosition);
                stAxis.stNcTOPLC.nCuRoadID:=stAxis.stPLCTONC.nRoadID_2;
			END_IF
		    stAxis.stNcTOPLC.fSetVelo:=_stAxis_Point.fVelocity;  
			stAxis.stNcTOPLC.fActVelo:=_stAxis_Point.fVelocity;
		END_IF
	
	END_IF
ELSE
    stAxis.stNcTOPLC.fDealtPos:=ABS(LTRUNC(_stAxis_Point.fPosition)-stAxis.stNcTOPLC.fActPos);    //01.13
	stAxis.stNcTOPLC.fActPos:=LTRUNC(_stAxis_Point.fPosition);
	//stAxis.stNcTOPLC.fSetVelo:=floor(_stAxis_Point.fVelocity);  //04.15注释
	stAxis.stNcTOPLC.fActVelo:=LTRUNC(_stAxis_Point.fVelocity);
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN    //04.15速度方向处理
	    stAxis.stNcTOPLC.fSetVelo:=stAxis.stNcTOPLC.fActVelo;
	ELSE
		stAxis.stNcTOPLC.fSetVelo:=-stAxis.stNcTOPLC.fActVelo;
	END_IF
	
END_IF


// 路径结束条件判断
IF (_fTime>=stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fTotalTime)THEN
	 _nIndex:=_nIndex+1;
	 _fTime:=0;
	 IF (stAxis.stAxisStatus.stPathRef.aExecutablePath[_nIndex].fTotalTime=0) THEN
	     _fTime:=0;
	     _bCalculateDone:=FALSE;
	     stAxis.stAxisStatus.stPathRef.bCalculateDone:=FALSE;
	     stAxis.stNcTOPLC.nAxisState:=2;
	     stAxis.stAxisStatus.nNcCycleCounter:=0;
		 IF (stAxis.stPLCTONC.stEndPosition.fVelocity=0)THEN   //12.03
		    stAxis.stNcTOPLC.fSetVelo:=0;
		    stAxis.stNcTOPLC.fActVelo:=0;
	         stAxis.stNcTOPLC.fSetAcc:=0;
		 END_IF
		 _fLastPosNC:=0;
		 _nIndex:=0;
		 _bSynMode:=FALSE;
		_bEstopping:=FALSE; //03.19
		 stAxis.stAxisStatus.bSynDecActive:=FALSE;
		 stAxis.stNcTOPLC.fDealtPos:=0;
	 END_IF 
END_IF

 stAxis.stAxisStatus.nSegIndex:=INT_TO_UDINT(_nIndex);
 
 _fLastPtyPos:=stAxis.stCodToNCParam.fActualPos;
 ]]></ST>
      </Implementation>
    </Action>
    <Action Name="A_UpdateNewTarPos" Id="{224b343e-37bc-49b3-ac49-2b05326ffb6c}">
      <Implementation>
        <ST><![CDATA[_fAcc:=stAxis.stPLCTONC.stEndPosition.fAccleration;
_fDec:=stAxis.stPLCTONC.stEndPosition.fDeceleration;
//根据指令分类
//IF (stAxis.stPLCTONC.eCommand<>E_Command.COMMAND_ABSOLUTEFORK) THEN	
IF (stAxis.stPLCTONC.nRoadID_1=0)THEN
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
		    _fUpNewPos:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGapSet-stAxis.stNcTOPLC.fActPos;
		ELSE
			_fUpNewPos:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGapSet-stAxis.stNcTOPLC.fActPos;
		END_IF
	ELSE
		IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
		    _fUpNewPos:=stAxis.stNcTOPLC.fActPos-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGapSet;
		ELSE
			_fUpNewPos:=stAxis.stNcTOPLC.fActPos-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGapSet;
		END_IF
	END_IF
ELSE   //fork指令 根据前动子的edpos id 和当前动子roadid分类讨论
	
	IF (_eDirection=E_Direction.DIRECTION_POSITIVE)THEN
		IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
		    _fUpNewPos:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGapSet-stAxis.stNcTOPLC.fActPos;
		ELSE
			_fUpNewPos:=_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGapSet-stAxis.stNcTOPLC.fActPos;
		END_IF
	ELSE
		IF (_pPremover^.stAxisStatus.stPathRef._nPathSegmentNum=1)THEN
		    _fUpNewPos:=stAxis.stNcTOPLC.fActPos-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[0].fEndPos-_fGapSet;
		ELSE
			_fUpNewPos:=stAxis.stNcTOPLC.fActPos-_pPremover^.stAxisStatus.stPathRef.aExecutablePath[1].fEndPos-_fGapSet;
		END_IF
	END_IF
     stAxis.stPLCTONC.stStartPosition.nRoadID:=stAxis.stNcTOPLC.nCuRoadID;
	 stAxis.stPLCTONC.stEndPosition.nRoadID:=stAxis.stNcTOPLC.nCuRoadID;
END_IF
	
_fDistance:=_fUpNewPos;
//_fTargetVelo:=stAxis.stNcTOPLC.fActVelo;  //11.1
// 11.01 停止计算距离，根据距离设置目标速度
IF _fDec<>0 THEN  //11.01 
   _fLastPosDeat:=0.5*stAxis.stNcTOPLC.fActVelo*stAxis.stNcTOPLC.fActVelo/_fDec;
END_IF 
IF LTRUNC(_fDistance)<=_fLastPosDeat THEN
	_fTargetVelo:=stAxis.stNcTOPLC.fActVelo;
ELSE
	_fTargetVelo:=stAxis.stPLCTONC.fTargetVelocity;
END_IF

_fVeloStart:=stAxis.stNcTOPLC.fActVelo;
_fVeloEnd:=0;
_bEnable:=TRUE;
_nPathSegment:=1;
stAxis.stAxisStatus.bSynStopping:=TRUE;  //10.28
IF GVL_MC.cDebug  THEN
	_sMessage:=FC_StrContact(stAxis,'SynStoping path');
	 ADSLOGSTR(ADSLOG_MSGTYPE_HINT, _sMessage, '');
END_IF

]]></ST>
      </Implementation>
    </Action>
