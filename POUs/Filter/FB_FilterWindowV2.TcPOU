<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_FilterWindowV2" Id="{bd6f65ec-0bbb-47cb-9d78-c6b5a0dbb3e4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FilterWindowV2
VAR_INPUT
	nWindowSize: UINT;
	///nLength         :UDINT;
	fData: LREAL;
END_VAR
VAR_OUTPUT
	fOutputData: LREAL;
END_VAR
VAR
	_nIndex: UINT;
	_nJIndex: UINT;
	_nIIndex: UINT;
	_nNum: UDINT;
	_aRawData: ARRAY[0..nSetSize] OF LREAL;
	_aDataTemp: ARRAY[0..nSetSize] OF LREAL;
	_fSum: LREAL;
END_VAR
VAR CONSTANT
	nSetSize: UINT := 1000;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF (nWindowSize<>0)THEN
	
		_aRawData[_nNum]:=fData;
		_fSum:=0;
		FOR _nIIndex:=0 TO (nWindowSize-1)  DO 
			_fSum:=_aRawData[_nIIndex]+_fSum;
		END_FOR
		fOutputData:=_fSum/nWindowSize;
		
		IF (_nNum>=(nWindowSize-1))THEN 

		   FOR _nJIndex:=1 TO (nWindowSize-1)  DO 
			   _aRawData[_nJIndex-1]:=_aRawData[_nJIndex];
		   END_FOR 
		ELSE
		   _nNum:=_nNum+1;     
		   fOutputData:=_fSum/_nNum;
		END_IF
	
ELSE
	fOutputData:=fData;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_FilterWindowV2">
      <LineId Id="3" Count="21" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>